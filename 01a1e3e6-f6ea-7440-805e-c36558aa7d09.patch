+async def _register(client: AsyncClient, email: str, role: str = "startup"):
+    return await client.post(
+        "/api/v1/auth/register",
+        json={
+            "email": email,
+            "password": PASSWORD,
+            "display_name": "Test Founder",
+            "role": role,
+        },
+    )
