+
+    # And submitting it did NOT move the readiness score denominator.
+    board = await client.get(
+        f"/api/v1/organizations/{org_id}/readiness", headers=s["auth"]["headers"]
+    )
+    assert board.json()["summary"]["criteria_total"] == 6
+
+
+# --- stage tools (5j) ------------------------------------------------------
