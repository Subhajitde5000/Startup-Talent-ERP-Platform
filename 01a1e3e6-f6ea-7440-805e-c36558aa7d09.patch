+
+
+class MentorReviewRead(BaseModel):
+    startup_name: str | None = None
+    session_topic: str | None = None
+    id: uuid.UUID
+    session_id: uuid.UUID
+    rating: int
+    public_text: str | None
+    private_feedback: str | None
+    public_consent: bool
