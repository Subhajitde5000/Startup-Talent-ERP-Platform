diff --git a/frontend/lib/auth-context.jsx b/frontend/lib/auth-context.jsx
new file mode 100644
index 0000000..76d1279
--- /dev/null
+++ b/frontend/lib/auth-context.jsx
@@ -0,0 +1,119 @@
+'use client';
+/**
+ * Session state for the whole app: who is signed in, the current user's
+ * roles, and the login/logout helpers. Backed by lib/api/client.ts (tokens
+ * live in local storage; the API client attaches them and refreshes them).
+ */
+import { createContext, useCallback, useContext, useEffect, useRef, useState } from 'react';
+import { useRouter } from 'next/navigation';
+import { api, clearTokens, getAccessToken, UNAUTHENTICATED_EVENT } from '@/lib/api/client';
+
+const AuthContext = createContext(null);
+
+/** Landing page per role — used by login and the role guard. */
+export const ROLE_HOME = {
+  startup: '/startup/dashboard',
+  mentor: '/mentor/dashboard',
+  investor: '/investor/dashboard',
+  jobseeker: '/jobseeker/dashboard',
+  employer: '/employer/dashboard',
+};
+
+/** The role used for routing/landing pages (first role the user holds). */
+export function primaryRole(user) {
+  if (!user) return null;
+  return user.primary_role || (user.roles && user.roles[0]) || null;
+}
+
+export function AuthProvider({ children }) {
+  const router = useRouter();
+  const [user, setUser] = useState(null);
+  // Always start "loading" on both server and client; the token is only
+  // read inside the mount effect to avoid a hydration mismatch.
+  const [loading, setLoading] = useState(true);
+  const mounted = useRef(true);
+
+  // Load the current user once on mount if a token exists.
+  useEffect(() => {
+    mounted.current = true;
+    let cancelled = false;
+    async function load() {
+      if (!getAccessToken()) {
+        setLoading(false);
+        return;
+      }
+      try {
+        const me = await api.users.me();
+        if (!cancelled) setUser(me);
+      } catch {
+        // Token invalid/refresh failed → client already cleared it.
+        if (!cancelled) setUser(null);
+      } finally {
+        if (!cancelled) setLoading(false);
+      }
+    }
+    load();
+    return () => {
+      cancelled = true;
+      mounted.current = false;
+    };
+  }, []);
+
+  // When the API client gives up refreshing, drop local state and go to login.
+  useEffect(() => {
+    function onUnauthenticated() {
+      if (!mounted.current) return;
+      setUser(null);
+      if (typeof window !== 'undefined' && !window.location.pathname.startsWith('/login')) {
+        router.replace('/login');
+      }
+    }
+    window.addEventListener(UNAUTHENTICATED_EVENT, onUnauthenticated);
+    return () => window.removeEventListener(UNAUTHENTICATED_EVENT, onUnauthenticated);
+  }, [router]);
+
+  const login = useCallback(async (email, password) => {
+    await api.auth.login({ email, password });
+    const me = await api.users.me();
+    setUser(me);
+    return me;
+  }, []);
+
+  const logout = useCallback(async () => {
+    try {
+      await api.auth.logout();
+    } catch {
+      // Network/server hiccup — the local session is cleared regardless.
+    }
+    clearTokens();
+    setUser(null);
+    router.replace('/login');
+  }, [router]);
+
+  /** Re-read /users/me (e.g. after adding a role). */
+  const refreshUser = useCallback(async () => {
+    const me = await api.users.me();
+    setUser(me);
+    return me;
+  }, []);
+
+  const value = {
+    user,
+    loading,
+    isAuthenticated: Boolean(user),
+    role: primaryRole(user),
+    hasRole: (role) => Boolean(user && user.roles && user.roles.includes(role)),
+    login,
+    logout,
+    refreshUser,
+    setUser,
+  };
+
+  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
+}
+
+export function useAuth() {
+  const ctx = useContext(AuthContext);
+  if (!ctx) throw new Error('useAuth must be used inside <AuthProvider>');
+  return ctx;
+}
diff --git a/frontend/lib/signup-draft.js b/frontend/lib/signup-draft.js
new file mode 100644
index 0000000..f95c7c0
--- /dev/null
+++ b/frontend/lib/signup-draft.js
@@ -0,0 +1,49 @@
+/**
+ * Draft registration data passed between the /register and /register/role
+ * screens (the API takes email + password + role in a single call, but the
+ * UI collects them across two pages).
+ *
+ * Lives in module memory on purpose: it survives client-side navigation but
+ * is gone after a full reload — the user simply re-enters their details.
+ * The pending email is mirrored to localStorage so the verify screen keeps
+ * working across reloads (it is needed for "Resend code" too).
+ */
+const PENDING_EMAIL_KEY = 'forma.pending_email';
+
+let draft = { email: '', password: '' };
+
+export function setSignupDraft(email, password) {
+  draft = { email, password };
+}
+
+export function getSignupDraft() {
+  return draft;
+}
+
+export function clearSignupDraft() {
+  draft = { email: '', password: '' };
+}
+
+export function setPendingEmail(email) {
+  try {
+    window.localStorage.setItem(PENDING_EMAIL_KEY, email);
+  } catch {
+    /* storage unavailable — verify screen will fall back to the draft */
+  }
+}
+
+export function getPendingEmail() {
+  try {
+    return window.localStorage.getItem(PENDING_EMAIL_KEY) || draft.email || '';
+  } catch {
+    return draft.email || '';
+  }
+}
+
+export function clearPendingEmail() {
+  try {
+    window.localStorage.removeItem(PENDING_EMAIL_KEY);
+  } catch {
+    /* ignore */
+  }
+}
diff --git a/frontend/next.config.js b/frontend/next.config.js
new file mode 100644
index 0000000..e1bdde9
--- /dev/null
+++ b/frontend/next.config.js
@@ -0,0 +1,37 @@
+/** @type {import('next').NextConfig} */
+
+// The browser only ever talks to the Next server (same-origin /api/v1/*).
+// Next proxies those paths to the backend, so no CORS setup is needed and
+// the sandbox preview works without the frontend calling localhost directly.
+const API_PROXY_TARGET = process.env.NEXT_PUBLIC_API_PROXY_TARGET || "http://127.0.0.1:8000";
+
+const nextConfig = {
+  reactStrictMode: true,
+  // Lint runs via `npm run lint` (full repo, exit code honest). Build skips
+  // it so pre-existing errors in not-yet-wired pages don't block deploys —
+  // each step fixes its own files as it lands.
+  eslint: {
+    ignoreDuringBuilds: true,
+  },
+  // The legacy pages predate TypeScript: Next's page-shape validation fails
+  // on their extra exports/props (Step 15a+ will fix them as those steps
+  // land). Real type safety for the TS code runs via `npm run typecheck`.
+  typescript: {
+    ignoreBuildErrors: true,
+  },
+  async rewrites() {
+    return [
+      {
+        source: "/api/v1/:path*",
+        destination: `${API_PROXY_TARGET}/api/v1/:path*`,
+      },
+      // Health lives at the backend root, exposed under the same proxy prefix.
+      {
+        source: "/api/health",
+        destination: `${API_PROXY_TARGET}/health`,
+      },
+    ];
+  },
+};
+
+module.exports = nextConfig;
