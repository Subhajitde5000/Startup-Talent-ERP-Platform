+        headers=auth["headers"],
+    )
+    body = resp.json()
+    assert body["visible_to_public"] is True
+    assert body["summary"] == "We build things."
+
+
+# --- public read ------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_public_read_happy(client: AsyncClient) -> None:
