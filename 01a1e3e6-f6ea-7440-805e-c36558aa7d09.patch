+def _market_payload(**overrides: object) -> dict:
+    payload = {
+        "metric": "tam",
+        "scenario": "base",
+        "value": "12000000000",
+        "unit": "currency",
+        "currency": "INR",
+        "estimate_year": 2025,
+        "source_type": "external_report",
+        "source_note": "Industry report 2025",
+        "confidence": "high",
+    }
+    payload.update(overrides)
+    return payload
