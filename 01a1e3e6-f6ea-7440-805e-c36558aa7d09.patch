+function downloadCsv(rows) {
+  // Prefix spreadsheet formula characters to prevent CSV formula injection.
+  const cell = (value) => {
+    let s = String(value ?? '');
+    if (/^[\s]*[=+\-@\t\r]/.test(s)) s = `'${s}`;
+    return `"${s.replace(/"/g, '""')}"`;
+  };
+  const data = [
+    ['Date', 'Startup', 'Session', 'Gross', 'Commission', 'TDS', 'Net', 'Currency', 'Status'],
+    ...rows.map((r) => [r.earned_on, r.startup_name, r.session_topic, r.gross_amount,
+      r.commission_amount, r.tds_amount, r.net_amount, r.currency, r.status]),
+  ];
+  const url = URL.createObjectURL(new Blob([data.map((r) => r.map(cell).join(',')).join('\r\n')], { type: 'text/csv;charset=utf-8' }));
+  const a = document.createElement('a');
+  a.href = url; a.download = 'earnings.csv'; a.click();
+  URL.revokeObjectURL(url);
