+"""Task model (Step 5c, schema.sql "tasks and milestones" section).
+
+Matches schema.sql exactly — no column deviations in this step.
+Portable types (same policy as migrations 0003-0009): ``task_status``
+and ``task_priority`` become VARCHAR + CHECK via
+``Enum(native_enum=False)``, never native PG enums.
+
+``readiness_id`` is created WITHOUT its foreign key on purpose
+(BUILD_PLAN 5c item 4): the FK and its cross-org validation arrive
+with Step 5f. It is not exposed in any 5c API schema (plan D1).
+"""
+
+import enum
+import uuid
+from datetime import date, datetime
+
+from sqlalchemy import (
+    CheckConstraint,
+    Date,
+    DateTime,
+    ForeignKey,
+    Integer,
+    Text,
+    func,
+)
+from sqlalchemy import (
+    Enum as SAEnum,
+)
+from sqlalchemy.dialects.postgresql import UUID as PG_UUID
+from sqlalchemy.orm import Mapped, mapped_column
+
+from app.db.base import Base
+
+
+class TaskStatus(enum.StrEnum):
+    """schema.sql ``task_status``. The UI maps its four columns onto
+    these values (``blocked`` is kept but has no board column yet)."""
+
+    todo = "todo"
+    in_progress = "in_progress"
+    in_review = "in_review"
+    blocked = "blocked"
+    done = "done"
+
+
+class TaskPriority(enum.StrEnum):
+    """schema.sql ``task_priority``."""
+
+    low = "low"
+    medium = "medium"
+    high = "high"
+    urgent = "urgent"
+
+
+class Task(Base):
+    __tablename__ = "tasks"
+
+    id: Mapped[uuid.UUID] = mapped_column(
+        PG_UUID(as_uuid=True), primary_key=True, default=uuid.uuid4
+    )
+    org_id: Mapped[uuid.UUID] = mapped_column(
+        PG_UUID(as_uuid=True),
+        ForeignKey("organizations.id", ondelete="CASCADE"),
+        nullable=False,
+    )
+    title: Mapped[str] = mapped_column(Text, nullable=False)
+    description: Mapped[str | None] = mapped_column(Text, nullable=True)
+    status: Mapped[TaskStatus] = mapped_column(
+        SAEnum(TaskStatus, name="task_status", native_enum=False, length=16),
+        nullable=False,
+        default=TaskStatus.todo,
+        server_default="todo",
+    )
+    priority: Mapped[TaskPriority] = mapped_column(
+        SAEnum(TaskPriority, name="task_priority", native_enum=False, length=16),
+        nullable=False,
+        default=TaskPriority.medium,
+        server_default="medium",
+    )
+    milestone_id: Mapped[uuid.UUID | None] = mapped_column(
+        PG_UUID(as_uuid=True),
+        ForeignKey("milestones.id", ondelete="SET NULL"),
+        nullable=True,
+    )
+    # FK added in Step 5f (BUILD_PLAN 5c item 4); not API-exposed yet (D1).
+    readiness_id: Mapped[uuid.UUID | None] = mapped_column(
+        PG_UUID(as_uuid=True), nullable=True
+    )
+    assignee_id: Mapped[uuid.UUID | None] = mapped_column(
+        PG_UUID(as_uuid=True),
+        ForeignKey("users.id", ondelete="SET NULL"),
+        nullable=True,
+    )
+    created_by: Mapped[uuid.UUID | None] = mapped_column(
+        PG_UUID(as_uuid=True),
+        ForeignKey("users.id", ondelete="SET NULL"),
+        nullable=True,
+    )
+    due_on: Mapped[date | None] = mapped_column(Date, nullable=True)
+    # Server-managed: set when the task reaches ``done``, cleared when it
+    # leaves ``done`` — never accepted from clients (plan D6).
+    completed_at: Mapped[datetime | None] = mapped_column(
+        DateTime(timezone=True), nullable=True
+    )
+    # Per-(org, status) column order; written only by the move endpoint
+    # (midpoint insert + per-column rebalance, plan D3).
+    display_order: Mapped[int] = mapped_column(
+        Integer, nullable=False, default=0, server_default="0"
+    )
+    created_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True), nullable=False, server_default=func.now()
+    )
+    updated_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True),
+        nullable=False,
+        server_default=func.now(),
+        onupdate=func.now(),
+    )
+    deleted_at: Mapped[datetime | None] = mapped_column(
+        DateTime(timezone=True), nullable=True
+    )
+
+    __table_args__ = (
+        # schema.sql: CHECK (length(btrim(title)) > 0) — trim() instead of
+        # btrim() so the constraint also evaluates on SQLite (identical
+        # default space-trimming behaviour on PostgreSQL).
+        CheckConstraint("length(trim(title)) > 0", name="tasks_title_check"),
+    )
diff --git a/backend/app/routers/milestones.py b/backend/app/routers/milestones.py
new file mode 100644
index 0000000..1fc090c
--- /dev/null
+++ b/backend/app/routers/milestones.py
@@ -0,0 +1,123 @@
+"""Milestone router (Step 5b).
+
+Thin routes (AGENTS.md section 3): the actor always comes from the auth
+dependency; path params are uuid.UUID so malformed ids 422 before any
+service code runs. Object-level membership checks, org scoping (IDOR)
+and owner validation live in milestone_service.
+"""
+
+import uuid
+from typing import Annotated, Literal
+
+from fastapi import APIRouter, Depends, Query
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.core.dependencies import get_current_user
+from app.db.session import get_db
+from app.models.milestone import MilestoneStatus
+from app.models.user import User
+from app.schemas.milestone import (
+    MilestoneCreate,
+    MilestonePage,
+    MilestoneRead,
+    MilestoneUpdate,
+)
+from app.services import milestone_service
+
+router = APIRouter(prefix="/organizations", tags=["milestones"])
+
+
+@router.post(
+    "/{org_id}/milestones",
+    response_model=MilestoneRead,
+    status_code=201,
+    summary="Create milestone",
+)
+async def create_milestone(
+    org_id: uuid.UUID,
+    payload: MilestoneCreate,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> MilestoneRead:
+    """Owner/admin/member create (viewer 403). Owner defaults to the
+    creator; a supplied owner must be an active member of this org
+    (422 on body.owner_id)."""
+    return await milestone_service.create_milestone(db, user, org_id, payload)
+
+
+@router.get(
+    "/{org_id}/milestones",
+    response_model=MilestonePage,
+    summary="List milestones",
+)
+async def list_milestones(
+    org_id: uuid.UUID,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+    limit: Annotated[int, Query(ge=1, le=100)] = 20,
+    offset: Annotated[int, Query(ge=0)] = 0,
+    sort: Literal["target_date", "created_at", "name", "status"] = "target_date",
+    order: Literal["asc", "desc"] = "asc",
+    status: Annotated[MilestoneStatus | None, Query()] = None,
+) -> MilestonePage:
+    """Active members (including viewers) list the org's live milestones,
+    paginated with whitelisted sort/filter fields."""
+    return await milestone_service.list_milestones(
+        db,
+        user,
+        org_id,
+        limit=limit,
+        offset=offset,
+        sort=sort,
+        order=order,
+        status=status,
+    )
+
+
+@router.get(
+    "/{org_id}/milestones/{milestone_id}",
+    response_model=MilestoneRead,
+    summary="Get milestone",
+)
+async def get_milestone(
+    org_id: uuid.UUID,
+    milestone_id: uuid.UUID,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> MilestoneRead:
+    """Read one milestone; an id from another organization is 404."""
+    return await milestone_service.get_milestone(db, user, org_id, milestone_id)
+
+
+@router.patch(
+    "/{org_id}/milestones/{milestone_id}",
+    response_model=MilestoneRead,
+    summary="Update milestone",
+)
+async def update_milestone(
+    org_id: uuid.UUID,
+    milestone_id: uuid.UUID,
+    payload: MilestoneUpdate,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> MilestoneRead:
+    """Owner/admin/member patch (viewer 403). Server-controlled fields
+    are rejected with 422 by extra=forbid."""
+    return await milestone_service.update_milestone(
+        db, user, org_id, milestone_id, payload
+    )
+
+
+@router.delete(
+    "/{org_id}/milestones/{milestone_id}",
+    status_code=204,
+    summary="Delete milestone (soft)",
+)
+async def delete_milestone(
+    org_id: uuid.UUID,
+    milestone_id: uuid.UUID,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> None:
+    """Soft delete (deleted_at set); repeat deletes are 404."""
+    await milestone_service.delete_milestone(db, user, org_id, milestone_id)
