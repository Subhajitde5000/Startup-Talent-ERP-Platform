

function RoundDetail({round,data,setData,owner,notify}:{round:FundraisingRound;data:ReturnType<typeof useStartupInvestors>['data'];setData:ReturnType<typeof useStartupInvestors>['setData'];owner:boolean;notify:(t:string)=>void}){const [tab,setTab]=useState('Overview');const [show,setShow]=useState(false);const [form,setForm]=useState({investorId:'',amount:'',instrument:round.instrument,status:'Offer received',notes:''});const [confirm,setConfirm]=useState(false);const update=(p:Partial<FundraisingRound>)=>setData(d=>({...d,rounds:d.rounds.map(r=>r.id===round.id?{...r,...p}:r)}));const committed=round.offers.filter(o=>['Committed','Funds received'].includes(o.status)).reduce((n,o)=>n+o.amount,0);const offers=(e:FormEvent)=>{e.preventDefault();const inv=data.investors.find(i=>i.id===form.investorId);if(!inv||+form.amount<=0)return;const offer:RoundOffer={id:rid('offer'),investorId:inv.id,investorName:inv.name,amount:+form.amount,instrument:form.instrument,status:form.status as RoundOffer['status'],date:new Date().toISOString(),notes:form.notes,manual:true};update({offers:[offer,...round.offers]});setShow(false);notify('Offer record saved locally; no offer was received, accepted or transmitted.')}};const postStatus=(o:RoundOffer,status:RoundOffer['status'])=>{update({offers:round.offers.map(x=>x.id===o.id?{...x,status}:x)});notify(`Local offer record marked ${status}. No legal acceptance or funds transfer occurred.`)};const tabList=['Overview','Offers and commitments','Term sheets','Cap table impact','Documents','Activity'];return <><Header title={round.name} subtitle={`${round.type} · ${round.status} · local planning record`}><Link className={styles.secondary} href="/startup/rounds"><ArrowLeft size={13}/> Rounds</Link><Button disabled={!owner||round.status==='Closed'} onClick={()=>setShow(true)}><Plus size={13}/> Record manual offer</Button><Button kind="primary" disabled={!owner||round.status==='Closed'} onClick={()=>setConfirm(true)}>Close round</Button></Header><Notice warning>Nothing here is a legal offer, signed term sheet, funding commitment, funds received or updated cap table. Verify all terms and consult counsel.</Notice><div className={styles.roundSummary}><div><span>Target</span><strong>{money(round.target)}</strong></div><div><span>Local manual commitments</span><strong>{money(committed)}</strong></div><div><span>Remaining</span><strong>{money(Math.max(0,round.target-committed))}</strong></div><div><span>Recorded investors</span><strong>{round.offers.length}</strong></div><Progress value={round.target?Math.min(100,committed/round.target*100):0}/><small>Progress includes only local manual status entries; not evidence of funds.</small></div><nav className={styles.viewTabs}>{tabList.map(t=><button key={t} onClick={()=>setTab(t)} className={tab===t?styles.activeTab:styles.tab}>{t}</button>)}</nav><div id="investor-main">{tab==='Overview'?<div className={styles.twoCol}><main className={styles.stack}><Card title="Round overview"><div className={styles.infoGrid}>{[['Status',round.status],['Instrument',round.instrument],['Valuation / cap',round.valuation||'Not set'],['Discount',round.discount||'Not set'],['Minimum',money(round.minimum)],['Maximum',round.maximum?money(round.maximum):'Not set'],['Closing date',dtext(round.closingDate)],['Visibility',round.visibility]].map(([k,v])=><div key={k}><small>{k}</small><strong>{v}</strong></div>)}</div><p>{round.useOfFunds||'Use of funds not entered.'}</p></Card><Card title="Timeline"><div className={styles.timeline}><span>Planning record created · {dtext(round.createdAt)}</span><span>Opening date entered · {dtext(round.openedAt)}</span><span>Offers and commitments are manual entries only</span></div></Card></main><aside className={styles.stack}><Card title="Round terms"><p>{round.name} · {round.type}</p><p>{round.instrument} · {round.valuation||'No valuation/cap'}</p><p>Target {money(round.target)} · minimum {money(round.minimum)}</p><p className={styles.caption}>No signed term sheet is stored.</p></Card><Card title="Closing checklist"><ul className={styles.checkList}><li>Minimum raise met: {committed>=round.minimum&&round.minimum>0?'Local entries reach minimum':'Not verified'}</li><li>Term sheet signed: not connected</li><li>Legal documents: not connected</li><li>Funds received: not verified</li><li>Cap table updated: not connected</li></ul></Card></aside></div>:tab==='Offers and commitments'?<Card title="Offers and commitments" subtitle="All entries below are founder-entered records."><Button disabled={!owner} onClick={()=>setShow(true)}><Plus size={13}/> Record offer</Button>{round.offers.length?round.offers.map(o=><article className={styles.offerRow} key={o.id}><div><strong>{o.investorName}</strong><small>{money(o.amount)} · {o.instrument} · {dtext(o.date)}</small><Chip status={o.status}>{o.status}</Chip><small>{o.notes||'No notes'} · Manual entry</small></div><Field label="Local status"><select disabled={!owner} value={o.status} onChange={e=>postStatus(o,e.target.value as RoundOffer['status'])}>{['Offer received','Under review','Accepted','Declined','Committed','Funds received'].map(s=><option key={s}>{s}</option>)}</select></Field></article>):<Empty title="No offer records." detail="Investor offer integrations are disconnected. You may record an external conversation as a private manual entry."/>}</Card>:tab==='Term sheets'?<Card title="Term sheets" subtitle="No generated or signed documents are connected."><Empty title="No term sheets stored." detail="Term-sheet version history, signatures and vault storage are unavailable."/><p className={styles.legal}>For information only, not legal advice. Have counsel review all proposed terms.</p></Card>:tab==='Cap table impact'?<Card title="Cap table impact" subtitle="Illustrative arithmetic only; no cap-table integration."><Notice warning>Estimates are not an ownership model. Confirm with your lawyer or finance adviser.</Notice><div className={styles.infoGrid}><div><small>Target raise</small><strong>{money(round.target)}</strong></div><div><small>Pre-money valuation / cap</small><strong>{round.valuation||'Not set'}</strong></div><div><small>Simple dilution estimate</small><strong>Not calculated</strong></div></div><p className={styles.emptyText}>No holder-level ownership data is connected, so dilution and post-round ownership are intentionally not inferred.</p></Card>:tab==='Documents'?<Card title="Round documents"><Empty title="No round documents." detail="Upload, signatures and document sharing are not connected." action="Open data room" href="/startup/data-room"/></Card>:<Card title="Activity"><p className={styles.emptyText}>A tamper-resistant audit log is not connected. Browser-local edits are not a legal audit trail.</p></Card>}</div>{show&&<Modal title="Record an external offer" onClose={()=>setShow(false)}><form className={styles.modalBody} onSubmit={offers}><Notice warning>This is a private manual record, not an offer received or accepted by the platform.</Notice><Field label="Investor"><select required value={form.investorId} onChange={e=>setForm({...form,investorId:e.target.value})}><option value="">Select a private pipeline record</option>{data.investors.map(i=><option key={i.id} value={i.id}>{i.name} · {i.firm}</option>)}</select></Field><Field label="Amount (₹)"><input type="number" min="1" required value={form.amount} onChange={e=>setForm({...form,amount:e.target.value})}/></Field><Field label="Instrument"><select value={form.instrument} onChange={e=>setForm({...form,instrument:e.target.value})}>{['Equity','SAFE','Convertible note','Other'].map(x=><option key={x}>{x}</option>)}</select></Field><Field label="Local status"><select value={form.status} onChange={e=>setForm({...form,status:e.target.value})}>{['Offer received','Under review','Accepted','Declined','Committed','Funds received'].map(x=><option key={x}>{x}</option>)}</select></Field><Field label="Notes"><textarea value={form.notes} onChange={e=>setForm({...form,notes:e.target.value})}/></Field><footer><Button onClick={()=>setShow(false)}>Cancel</Button><Button type="submit" kind="primary" disabled={!owner}>Save private record</Button></footer></form></Modal>}{confirm&&<Modal title="Close this local round record?" onClose={()=>setConfirm(false)}><div className={styles.modalBody}><Notice warning>Changing this local status does not notify investors, close a financing, update a profile or modify a cap table.</Notice><p>Minimum raise: {money(round.minimum)} · manual commitments: {money(committed)}.</p><footer><Button onClick={()=>setConfirm(false)}>Cancel</Button><Button kind="primary" disabled={!owner} onClick={()=>{update({status:'Closed'});setConfirm(false);notify('Round record marked closed locally only.')}}>Mark local record closed</Button></footer></div></Modal>}<Disclaimer/></>}
function InvestorSettings({data,setData,owner,ready,notify}:{data:ReturnType<typeof useStartupInvestors>['data'];setData:ReturnType<typeof useStartupInvestors>['setData'];owner:boolean;ready:boolean;notify:(t:string)=>void}){const setting=data.settings;const change=(patch:Partial<typeof setting>)=>{setData(d=>({...d,settings:{...d.settings,...patch}}));notify('Preference saved in this browser only; no visibility or access change was published.')};const visibilityOptions:[InvestorData['settings']['visibility'],string,string][]=[['Private','Private','Only your team can see investor settings.'],['Mentors only','Mentors only','Mentors may see shared preparation information; access service is not connected.'],['Mentors and verified investors','Mentors and verified investors','Not available until verified Investment Ready sign-off; no directory is connected.']];const toggles:[keyof InvestorSettings,string,string][]=[['profileSummary','Profile summary','Company description and profile basics'],['traction','Traction numbers','Choose which verified metrics to show'],['team','Team details','Founder and team information'],['funding','Funding details','Funding context'],['round','Round information','Round target and instrument'],['readiness','Readiness score and badge','Only after verified mentor sign-off']];const blocked=data.investors.filter(i=>i.blocked);const hidden=data.investors.filter(i=>i.hidden);return <><Header title="Investor visibility settings" subtitle="Keep investor visibility private by default and review what would be shared."><Link className={styles.secondary} href="/startup/investors"><ArrowLeft size={13}/> Investor hub</Link></Header><Notice warning>Settings persist only in this browser. Visibility publication, identity verification and investor access controls are not connected.</Notice><div id="investor-main" className={styles.settingsLayout}><nav className={styles.settingsNav}>{['Visibility','What investors can see','Investor controls','Data room defaults','Notifications','Pause visibility'].map((x,i)=><a href={`#investor-setting-${i}`} key={x}>{x}</a>)}</nav><main className={styles.stack}><Card title="Who can see my startup" subtitle="Private is the default. Selecting a preference does not publish your profile."><div id="investor-setting-0" className={styles.visibilityOptions}>{visibilityOptions.map(([value,title,desc])=><label key={value} className={setting.visibility===value?styles.optionActive:styles.option}><input type="radio" name="visibility" checked={setting.visibility===value} disabled={!owner||(value==='Mentors and verified investors'&&!ready)} onChange={()=>change({visibility:value})}/><span><strong>{title}</strong><small>{desc}</small></span>{value==='Mentors and verified investors'&&!ready&&<Chip status="locked">Locked</Chip>}</label>)}</div>{!ready&&<Notice warning>Investor visibility stays locked because mentor sign-off is not verified. There is no owner override in this disconnected demo.</Notice>}</Card><Card title="What investors can see"><div id="investor-setting-1">{toggles.map(([key,title,desc])=><label className={styles.toggleRow} key={key}><span><strong>{title}</strong><small>{desc}</small></span><input type="checkbox" checked={Boolean(setting[key])} disabled={!owner||(!ready&&key==='readiness')} onChange={e=>change({[key]:e.target.checked} as Partial<InvestorSettings>)}/><i/></label>)}<Button onClick={()=>notify('Preview is illustrative; no investor view session exists.')}>Preview as investor</Button></div></Card><Card title="Investor controls"><div id="investor-setting-2" className={styles.twoCol}><Field label="Preferred investor types"><select disabled={!owner}><option>Any verified type · not synced</option><option>Angel</option><option>Angel group</option><option>Fund</option></select></Field><Field label="Preferred ticket range"><input disabled={!owner} placeholder="Not set · not synced"/></Field></div><h3>Blocked investors</h3>{blocked.length?blocked.map(i=><div className={styles.settingRow} key={i.id}><span>{i.name} · {i.firm}<small>Private manual record</small></span><Button disabled={!owner} onClick={()=>setData(d=>({...d,investors:d.investors.map(x=>x.id===i.id?{...x,blocked:false}:x)}))}>Unblock</Button></div>):<p className={styles.emptyText}>No blocked investor records.</p>}<h3>Hidden from recommendations</h3>{hidden.length?hidden.map(i=><div className={styles.settingRow} key={i.id}><span>{i.name} · {i.firm}</span><Button disabled={!owner} onClick={()=>setData(d=>({...d,investors:d.investors.map(x=>x.id===i.id?{...x,hidden:false}:x)}))}>Unhide</Button></div>):<p className={styles.emptyText}>No hidden contacts.</p>}</Card><Card title="Data room defaults"><div id="investor-setting-3" className={styles.stack}><label className={styles.checkField}><input type="checkbox" checked={setting.ndaRequired} disabled={!owner} onChange={e=>change({ndaRequired:e.target.checked})}/> Require NDA <small>Workflow cannot enforce this setting.</small></label><label className={styles.checkField}><input type="checkbox" checked={setting.watermark} disabled={!owner} onChange={e=>change({watermark:e.target.checked})}/> Recommend watermarking <small>No watermark service is connected.</small></label><Field label="Download policy"><select disabled={!owner} value={setting.downloadPolicy} onChange={e=>change({downloadPolicy:e.target.value as InvestorSettings['downloadPolicy']})}><option>View only</option><option>Allow selected downloads</option></select></Field><Field label="Default access expiry"><input type="date" disabled={!owner} value={setting.accessExpiry} onChange={e=>change({accessExpiry:e.target.value})}/></Field></div></Card><Card title="Notifications"><div id="investor-setting-4">{['views','shortlists','messages','access requests','offers'].map(x=><label className={styles.checkField} key={x}><input type="checkbox" checked={setting.alerts.includes(x)} onChange={e=>change({alerts:e.target.checked?[...setting.alerts,x]:setting.alerts.filter(a=>a!==x)})}/>{x}</label>)}<Field label="Digest frequency"><select><option>Daily · local preference</option><option>Weekly</option><option>Immediate</option></select></Field></div></Card><Card title="Pause investor visibility"><div id="investor-setting-5" className={styles.pauseRow}><span><strong>{setting.paused?'Visibility paused':'Visibility not paused'}</strong><small>Pause is a local preference and does not unpublish a live profile.</small></span><Button kind={setting.paused?'primary':'danger'} disabled={!owner} onClick={()=>change({paused:!setting.paused})}>{setting.paused?'Resume':'Pause visibility'}</Button></div></Card><Disclaimer/></main></div></>}
