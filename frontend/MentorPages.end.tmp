

function ReadinessPage({items,setData,data,canEdit,canManage,team,notify}:{items:ReadinessItem[];setData:ReturnType<typeof useMentorWorkspace>['setData'];data:ReturnType<typeof useMentorWorkspace>['data'];canEdit:boolean;canManage:boolean;team:string[];notify:(text:string)=>void}){const active=data.mentorships.filter(m=>m.status==='Active');const signed=items.filter(i=>i.status==='Signed off').length;const percent=items.length?Math.round(signed/items.length*100):0;const change=(item:ReadinessItem,patch:Partial<ReadinessItem>)=>setData(d=>({...d,readiness:d.readiness.map(i=>i.id===item.id?{...i,...patch,updatedAt:new Date().toISOString()}:i)}));const addEvidence=(item:ReadinessItem,value:string)=>{if(!value.trim())return;change(item,{evidence:[...item.evidence,value.trim()],status:item.status==='Not started'?'In progress':item.status});};const submit=(item:ReadinessItem)=>{if(!active.some(m=>m.mentorName===item.mentorName)){notify('Assign an active mentor before requesting sign-off.');return;}change(item,{status:'Submitted for sign-off'});notify('Sign-off request saved locally. No mentor has been notified.');};return <><Header title="Investment readiness" subtitle="Organize evidence and request mentor review. No readiness score is calculated."><Link className={styles.secondaryButton} href="/startup/mentors">Mentors overview</Link><Link className={styles.secondaryButton} href="/startup/tasks">Open tasks <ArrowRight size={13}/></Link></Header><Note tone="warning">Readiness progress is a checklist of local records, not an assessment. Sign-off is earned only through mentor review; the startup cannot mark an item signed off.</Note><section id="mentor-main" className={styles.readinessSummary}><div className={styles.readinessSummaryTop}><div><span className={styles.eyebrow}>Mentor sign-offs</span><h2>{signed} of {items.length} signed off</h2><p>{items.filter(i=>i.status==='Submitted for sign-off').length} items awaiting review · {items.filter(i=>i.status==='Changes requested').length} returned for changes</p></div><span className={styles.statusPill}>{signed===items.length&&items.length?'Complete':'Not assessed'}</span></div><div className={styles.progress}><i style={{width:`${percent}%`}}/></div><small>This bar represents signed checklist items only. It is not an investment-readiness score or a guaranteed funding outcome.</small></section>{items.some(i=>i.status==='Signed off')&&<div className={styles.badgeCard}><ShieldCheck size={18}/><span><strong>Investment Ready sign-offs recorded</strong><small>Readiness badge issuance, verification and expiry are not connected.</small></span></div>}<div className={styles.readinessList}>{items.map((item,index)=>{const assigned=active.find(m=>m.mentorName===item.mentorName);return <article className={styles.readinessItem} key={item.id}><div className={styles.readinessNumber}>{String(index+1).padStart(2,'0')}</div><div className={styles.readinessContent}><div className={styles.readinessItemHead}><div><h2>{item.title}</h2><p>{item.criteria}</p></div><Chip tone={item.status}>{item.status}</Chip></div><div className={styles.formGrid}><label className={styles.field}>Owner<select disabled={!canEdit} value={item.owner} onChange={e=>change(item,{owner:e.target.value})}><option value="">Select an owner</option>{team.map(x=><option key={x}>{x}</option>)}</select></label><label className={styles.field}>Mentor reviewer<select disabled={!canManage||!active.length} value={item.mentorName} onChange={e=>change(item,{mentorName:e.target.value})}><option value="">No active mentor assigned</option>{active.map(m=><option key={m.id}>{m.mentorName}</option>)}</select></label></div><div className={styles.evidenceBlock}><strong>Evidence and notes</strong>{item.evidence.length?<ul>{item.evidence.map((e,i)=><li key={`${e}-${i}`}><FileText size={13}/>{e}<button disabled={!canEdit} onClick={()=>change(item,{evidence:item.evidence.filter((_,ix)=>ix!==i)})} aria-label={`Remove ${e}`}><X size={12}/></button></li>)}</ul>:<p>No evidence attached.</p>}<EvidenceForm disabled={!canEdit} onAdd={value=>addEvidence(item,value)}/><label className={styles.field}>Notes<textarea rows={2} disabled={!canEdit} value={item.note} onChange={e=>change(item,{note:e.target.value})} placeholder="Context, source, last-updated date…"/></label></div><div className={styles.readinessActions}>{item.status==='Signed off'?<span className={styles.signedInfo}><CheckCircle2 size={14}/> Signed off · {item.updatedAt?dateText(item.updatedAt.slice(0,10)):'date unavailable'}</span>:<><button className={styles.secondaryButton} disabled={!canEdit||!item.evidence.length} onClick={()=>change(item,{status:'In progress'})}>Mark in progress</button><button className={styles.primaryButton} disabled={!canEdit||!item.evidence.length||!assigned} onClick={()=>submit(item)}>Submit for sign-off <ArrowRight size={12}/></button></>}<span className={styles.caption}>{assigned?`Reviewer · ${assigned.mentorName}`:'An active mentor must be assigned before review can be requested.'}</span></div></div></article>;})}</div><section className={styles.card}><CardTitle title="Badge and verification"/><div className={styles.twoColumn}><div className={styles.metricBox}><span>Badge status</span><strong>{signed===items.length&&items.length?'Not issued':'Not earned'}</strong><small>A connected verification service is required to issue any badge.</small></div><div className={styles.metricBox}><span>Score</span><strong>Not calculated</strong><small>No numeric readiness score is shown or inferred.</small></div></div></section>{!canManage&&<ReadOnly/>}</>;}
function EvidenceForm({disabled,onAdd}:{disabled:boolean;onAdd:(value:string)=>void}){const [value,setValue]=useState('');return <form className={styles.inlineForm} onSubmit={e=>{e.preventDefault();onAdd(value);setValue('');}}><input disabled={disabled} value={value} onChange={e=>setValue(e.target.value)} placeholder="Add a document name, task or evidence link"/><button className={styles.secondaryButton} disabled={disabled||!value.trim()}><Plus size={12}/> Add evidence</button></form>;}
function SessionDetail({session,setData,canEdit,updateTask,startupName,notify}:{session:MentorSession;data:ReturnType<typeof useMentorWorkspace>['data'];setData:ReturnType<typeof useMentorWorkspace>['setData'];canEdit:boolean;updateTask:(taskId:string,updates:Record<string,unknown>)=>void;startupName:string;notify:(text:string)=>void}){const {addTask,data:workspace}=useStartupWorkspace();const {data}=useMentorWorkspace();const [notes,setNotes]=useState(session.notes);const [actions,setActions]=useState(session.actions);const [feedback,setFeedback]=useState(session.feedback);const [rating,setRating]=useState(session.rating||0);const [newAction,setNewAction]=useState('');const setSession=(patch:Partial<MentorSession>)=>setData(d=>({...d,sessions:d.sessions.map(s=>s.id===session.id?{...s,...patch}:s)}));const createTask=()=>{if(!newAction.trim())return;addTask({title:newAction.trim(),moduleLabel:'Tasks',moduleHref:'/startup/tasks',dueLabel:'No due date',owner:workspace.startup.founderName,status:'pending',priority:'Medium',labels:['mentor-session'],description:`Follow-up from ${session.topic} with ${session.mentorName}.`,mentorDeliverable:true,mentorStatus:'not-requested'});setNewAction('');notify('Follow-up task added to the task hub.');};const canReview=session.status==='Completed';return <><Header title={session.topic} subtitle={`${session.mentorName} · ${dateTime(session.date)} · ${session.duration} minutes`}><Link className={styles.secondaryButton} href="/startup/sessions"><ArrowLeft size={14}/> Sessions</Link><button className={styles.primaryButton} onClick={()=>notify('Video service is not connected; no join link is available.')}><Video size={13}/> Join session</button></Header><div className={styles.detailLayout}><main id="mentor-main" className={styles.mainColumn}><section className={styles.card}><div className={styles.sessionDetailTop}><div><Chip tone={session.status}>{session.status}</Chip><p><CalendarDays size={13}/> {dateTime(session.date)} · {session.timezone}</p><p><Clock3 size={13}/> {session.duration} minutes · {session.attendees.join(', ')||'No attendees listed'}</p></div><Chip tone={session.paymentStatus}>Payment · {session.paymentStatus}</Chip></div><div className={styles.agendaBox}><h2>Agenda</h2><p>{session.agenda||'No agenda added.'}</p></div><Note>Managed video and recording storage are not connected. Recording consent is off by default; no recording exists here.</Note></section><section className={styles.card}><CardTitle title="Meeting notes" subtitle="Saved locally in this browser."/><label className={styles.field}>Notes<textarea rows={6} value={notes} disabled={!canEdit} onChange={e=>setNotes(e.target.value)} placeholder="Capture key decisions and context…"/></label><label className={styles.field}>Action items<textarea rows={4} value={actions} disabled={!canEdit} onChange={e=>setActions(e.target.value)} placeholder="One action per line…"/></label><button className={styles.primaryButton} disabled={!canEdit} onClick={()=>{setSession({notes,actions});notify('Session notes saved locally.');}}>Save notes</button><div className={styles.inlineForm}><input value={newAction} disabled={!canEdit} onChange={e=>setNewAction(e.target.value)} placeholder="Turn a follow-up into a startup task"/><button className={styles.secondaryButton} disabled={!canEdit||!newAction.trim()} onClick={createTask}><Plus size={13}/> Add task</button></div><p className={styles.caption}>Creates a local task linked by mentor-session label; no mentor review is requested automatically.</p></section><section className={styles.card}><CardTitle title="Files & recording"/><Empty title="No files or recording." detail="File storage and managed video are not connected. Recording consent was not collected."/></section></main><aside className={styles.sideColumn}><section className={styles.card}><CardTitle title="Session actions"/><div className={styles.termsList}><div><span>Mentor</span><strong>{session.mentorName}</strong></div><div><span>Payment</span><strong>{session.paymentStatus}</strong></div><div><span>Recording</span><strong>Off</strong></div></div>{['Scheduled','Confirmed'].includes(session.status)&&<><button className={styles.secondaryButton} disabled={!canEdit} onClick={()=>{setSession({status:'Reschedule requested'});notify('Reschedule request saved locally; mentor was not notified.');}}>Request reschedule</button><button className={styles.secondaryButton} disabled={!canEdit} onClick={()=>{setSession({status:'Cancelled'});notify('Session cancelled locally; calendar invite was not updated.');}}>Cancel session</button></>}</section>{canReview&&<section className={styles.card}><CardTitle title="Session feedback" subtitle="Private to this startup workspace; not a public review."/><label className={styles.field}>Your rating<div className={styles.stars}>{[1,2,3,4,5].map(n=><button key={n} aria-label={`${n} stars`} className={rating>=n?styles.starSelected:styles.star} onClick={()=>setRating(n)}><Star size={19} fill={rating>=n?'currentColor':'none'}/></button>)}</div></label><label className={styles.field}>Feedback<textarea rows={4} value={feedback} onChange={e=>setFeedback(e.target.value)} placeholder="What was useful? What could be improved?"/></label><button className={styles.primaryButton} onClick={()=>{setSession({rating,feedback});notify('Private feedback saved locally; it is not published.');}}>Save feedback</button><p className={styles.caption}>Public mentor reviews require a connected, verified session system.</p></section>}</aside></div>{!canReview&&<Note>Feedback becomes available after the session status is completed. Status changes require mentor confirmation; this prototype does not let the startup mark a session complete.</Note>}</>;}
function BillingPage({mentoring}:{mentoring:Mentorship}){return <><Header title="Agreements & billing" subtitle={`${mentoring.mentorName} · ${mentoring.status} mentorship`}><Link className={styles.secondaryButton} href={`/startup/mentors/${mentoring.id}`}><ArrowLeft size={14}/> Workspace</Link></Header><Note tone="warning">No contract, invoicing, escrow, payment processing or platform-fee service is connected. Do not treat the mentorship status as a signed agreement.</Note><div id="mentor-main" className={styles.detailLayout}><main className={styles.mainColumn}><section className={styles.card}><CardTitle title="Agreement status" subtitle="Local mentorship record only."/><div className={styles.agreementEmpty}><FileText size={22}/><strong>No agreement stored</strong><p>Neither party’s signature, scope, confidentiality terms, cancellation policy or liability terms are recorded here.</p><button className={styles.secondaryButton} disabled onClick={()=>{}}>Create agreement · unavailable</button></div></section><section className={styles.card}><CardTitle title="Session charges"/><Empty title="No invoices or charges." detail="Session fees and taxes have not been supplied or processed."/></section></main><aside className={styles.sideColumn}><section className={styles.card}><CardTitle title="Platform fees"/><div className={styles.notScored}><strong>Not configured</strong><small>Commission rates, payment schedules and refunds are not available in this workspace.</small></div></section><section className={styles.card}><CardTitle title="Before agreeing"/><ul className={styles.checklist}><li>Confirm scope and deliverables directly.</li><li>Discuss any cash, equity or advisory arrangement.</li><li>Review confidentiality, data access and termination terms.</li><li>Seek independent legal or financial advice where appropriate.</li></ul></section></aside></div></>;}
