function DeliverablesSection({data,setData,notify}:{data:MentorRoleData;setData:React.Dispatch<React.SetStateAction<MentorRoleData>>;notify:(s:string)=>void}){const [tab,setTab]=useState('Awaiting review');const [query,setQuery]=useState('');const [selected,setSelected]=useState<{startupId:string;deliverableId:string}|null>(null);const [note,setNote]=useState('');const [dueDate,setDueDate]=useState('');const [rating,setRating]=useState<'Does not meet'|'Meets'|'Exceeds'|'No rating'>('No rating');const [showAdd,setShowAdd]=useState(false);const [addForm,setAddForm]=useState({startupId:'',title:'',description:'',dueDate:'',format:'Document'});const verified=data.verifiedStatus==='Verified';const rows=data.startups.flatMap(s=>s.deliverables.map(d=>({...d,startupId:s.id,startupName:s.startupName,stage:s.stage})));const matches=(d:typeof rows[number])=>(!query||`${d.title} ${d.startupName}`.toLowerCase().includes(query.toLowerCase()))&&(tab==='All'||tab==='Awaiting review'&&d.status==='Submitted'||tab==='Requested by me'&&d.manual&&d.status!=='Accepted'||tab==='Accepted'&&d.status==='Accepted'||tab==='Changes requested'&&d.status==='Changes requested');const list=rows.filter(matches).sort((a,b)=>new Date(a.submittedAt||a.dueDate||'').getTime()-new Date(b.submittedAt||b.dueDate||'').getTime());const item=selected?data.startups.find(s=>s.id===selected.startupId)?.deliverables.find(d=>d.id===selected.deliverableId):undefined;const update=(patch:Partial<MentorDeliverable>)=>selected&&setData(d=>({...d,startups:d.startups.map(s=>s.id===selected.startupId?{...s,deliverables:s.deliverables.map(x=>x.id===selected.deliverableId?{...x,...patch}:x)}:s)}));const decide=(status:MentorDeliverable['status'])=>{if(status==='Changes requested'&&note.trim().length<20){notify('A change request note of at least 20 characters is required.');return}update({status,feedback:note,rating:rating==='No rating'?undefined:rating});setSelected(null);notify(`Deliverable marked ${status} in the local record; the startup was not notified.`)};const create=(e:FormEvent)=>{e.preventDefault();if(!addForm.title.trim()||!addForm.dueDate)return;setData(d=>({...d,startups:d.startups.map(s=>s.id===addForm.startupId?{...s,deliverables:[{id:rid('deliverable'),title:addForm.title.trim(),description:addForm.description,dueDate:addForm.dueDate,owner:'Startup owner',status:'To do',feedback:'',manual:true,expectedFormat:addForm.format},...s.deliverables]}:s)}));setShowAdd(false);notify('Deliverable request saved locally; no startup task was created.')};return <section id="mentor-deliverables" className={styles.rollSection}><SectionHeader title="Deliverables review" subtitle="A single queue for work shared by startups in your mentorships."><Button disabled={!verified||!data.startups.some(s=>s.status==='Active')} onClick={()=>setShowAdd(true)}><Plus size={13}/> Add deliverable</Button></SectionHeader><Notice warning>{verified?'Task synchronization and notifications are disconnected.':'Your mentor profile is under review. Deliverable decisions are disabled.'}</Notice><div className={styles.stats}>{[['Awaiting review',rows.filter(d=>d.status==='Submitted').length],['Overdue',rows.filter(d=>new Date(d.dueDate)<new Date()&&!['Accepted'].includes(d.status)).length],['Accepted this month',rows.filter(d=>d.status==='Accepted').length],['Average review time','—']].map(r=><div key={String(r[0])}><span>{r[0]}</span><strong>{r[1]}</strong></div>)}</div><div className={styles.toolbar}><nav className={styles.tabs}>{['Awaiting review','Requested by me','Accepted','Changes requested','All'].map(t=><button key={t} className={tab===t?styles.tabActive:styles.tab} onClick={()=>setTab(t)}>{t}</button>)}</nav><label className={styles.search}><Search size={13}/><input value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search deliverables"/></label></div><div className={styles.tableWrap}><table><thead><tr>{['Deliverable','Startup','Due date','Submitted','Status','Owner','Actions'].map(x=><th key={x}>{x}</th>)}</tr></thead><tbody>{list.map(d=><tr key={d.id}><td>{d.title}<small>{d.description||'No description'} · {d.expectedFormat||'Format not specified'}</small></td><td>{d.startupName} · {d.stage}</td><td>{fmt(d.dueDate)}</td><td>{d.submittedAt?fmt(d.submittedAt):'Not submitted'}</td><td><Status value={d.status}/></td><td>{d.owner}</td><td><Button onClick={()=>{setSelected({startupId:d.startupId,deliverableId:d.id});setNote(d.feedback||'');setDueDate('');setRating(d.rating||'No rating')}}>Review</Button><Link className={styles.textLink} href={`/mentor/startups/${d.startupId}`}>Workspace</Link></td></tr>)}</tbody></table></div>{!list.length&&<Empty title={tab==='Awaiting review'?"You're all caught up.":`No ${tab.toLowerCase()} deliverables.`} detail="No deliverable submissions are shared with this mentor. Startup tasks are not fetched without access." action="Open My Startups" href="#mentor-startups"/>}{selected&&item&&<div className={styles.modal}><section role="dialog" aria-modal="true" aria-labelledby="deliverable-review-title"><header><div><span className={styles.sectionKicker}>{data.startups.find(s=>s.id===selected.startupId)?.startupName}</span><h3 id="deliverable-review-title">{item.title}</h3></div><button className={styles.iconButton} onClick={()=>setSelected(null)} aria-label="Close"><X size={16}/></button></header><div className={styles.modalBody}><Notice warning>Submission content and file previews aren't connected. Review only data explicitly shared by the startup.</Notice><p><b>Description:</b> {item.description||'Not provided'}</p><p><b>Expected format:</b> {item.expectedFormat||'Not set'} · <b>Due:</b> {fmt(item.dueDate)}</p><p><b>Submission:</b> {item.submissionText||'No shared file or link.'}</p><Field label="Review note"><textarea maxLength={1000} value={note} onChange={e=>setNote(e.target.value)} placeholder="Feedback to the startup"/></Field><Field label="Rating"><select value={rating} onChange={e=>setRating(e.target.value as typeof rating)}><option>No rating</option><option>Does not meet</option><option>Meets</option><option>Exceeds</option></select></Field><Field label="New due date (optional)"><input type="date" value={dueDate} onChange={e=>setDueDate(e.target.value)}/></Field><p className={styles.caption}>Accepting or requesting changes would normally update the startup's task and notify them; this is a local-only record.</p><div className={styles.inlineActions}><Button onClick={()=>setSelected(null)}>Close</Button><Button disabled>Mark as seen</Button><Button disabled={!verified||note.trim().length<20} onClick={()=>decide('Changes requested')}>Request changes</Button><Button primary disabled={!verified} onClick={()=>decide('Accepted')}>Accept</Button></div></div></section></div>}{showAdd&&<div className={styles.modal}><section role="dialog" aria-modal="true" aria-label="Add deliverable"><header><h3>Request a deliverable</h3><button className={styles.iconButton} onClick={()=>setShowAdd(false)} aria-label="Close"><X size={16}/></button></header><form className={styles.modalBody} onSubmit={create}><Notice>Local proposal only. No task is created or sent to a startup.</Notice><Field label="Startup"><select required value={addForm.startupId} onChange={e=>setAddForm({...addForm,startupId:e.target.value})}><option value="">Select active mentorship</option>{data.startups.filter(s=>s.status==='Active').map(s=><option key={s.id} value={s.id}>{s.startupName}</option>)}</select></Field><Field label="Goal"><select><option>Choose a shared goal (not connected)</option></select></Field><Field label="Title"><input required value={addForm.title} onChange={e=>setAddForm({...addForm,title:e.target.value})}/></Field><Field label="Description"><textarea value={addForm.description} onChange={e=>setAddForm({...addForm,description:e.target.value})}/></Field><Field label="Expected format"><select value={addForm.format} onChange={e=>setAddForm({...addForm,format:e.target.value})}>{['Document','Link','Spreadsheet','Other'].map(x=><option key={x}>{x}</option>)}</select></Field><Field label="Due date"><input required type="date" min={new Date().toISOString().slice(0,10)} value={addForm.dueDate} onChange={e=>setAddForm({...addForm,dueDate:e.target.value})}/></Field><footer><Button onClick={()=>setShowAdd(false)}>Cancel</Button><Button primary disabled={!verified} >Save local request</Button></footer></form></section></div>}</section>}
