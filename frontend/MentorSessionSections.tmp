function SessionsSection({data,setData,notify}:{data:MentorRoleData;setData:React.Dispatch<React.SetStateAction<MentorRoleData>>;notify:(s:string)=>void}){
 const [tab,setTab]=useState('Upcoming');const [query,setQuery]=useState('');const [week,setWeek]=useState(0);const verified=data.verifiedStatus==='Verified';
 const sessions=data.startups.flatMap(startup=>startup.sessions.map(session=>({...session,startupName:startup.startupName,startupId:startup.id})));
 const upcoming=sessions.filter(s=>['Scheduled','Confirmed'].includes(s.status)&&new Date(s.date)>=new Date()).sort((a,b)=>a.date.localeCompare(b.date));
 const needs=sessions.filter(s=>s.status==='Completed'&&!s.notes?.trim()).sort((a,b)=>a.date.localeCompare(b.date));
 const past=sessions.filter(s=>s.status==='Completed'||s.status==='Cancelled').sort((a,b)=>b.date.localeCompare(a.date));
 const list=(tab==='Upcoming'?upcoming:tab==='Needs summary'?needs:past).filter(s=>`${s.startupName} ${s.topic}`.toLowerCase().includes(query.toLowerCase()));
 const now=new Date();const monday=new Date(now);monday.setDate(now.getDate()-((now.getDay()+6)%7)+week*7);const days=Array.from({length:7},(_,i)=>{const d=new Date(monday);d.setDate(monday.getDate()+i);return d});
 const updateStatus=(sessionId:string,status:MentorRoleSession['status'])=>{setData(d=>({...d,startups:d.startups.map(st=>({...st,sessions:st.sessions.map(s=>s.id===sessionId?{...s,status}:s)}))}));notify(`Session marked ${status} in the local record. No one was notified.`)};
 const exportCsv=()=>{const rows=[['Date','Startup','Topic','Duration','Type','Status','Summary'],...past.map(s=>[s.date,s.startupName,s.topic,s.duration,s.type||'Regular',s.status,s.notes?'Added':'Missing'])];const blob=new Blob([rows.map(r=>r.join(',')).join('\n')],{type:'text/csv'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='mentor-sessions-local.csv';a.click();URL.revokeObjectURL(url)};
 return <section id="mentor-sessions" className={styles.rollSection}><SectionHeader title="Sessions" subtitle="One list across your mentorships. Time zone is Asia/Kolkata; calendar and video services are disconnected."><Button disabled={!verified||!data.startups.some(s=>s.status==='Active')}>+ Schedule session</Button></SectionHeader><div className={styles.stats}>{[['Sessions this week',upcoming.filter(s=>{const d=new Date(s.date);return d>=monday&&d<new Date(monday.getTime()+7*86400000)}).length],['Hours mentored this month',Math.round(sessions.filter(s=>new Date(s.date).getMonth()===now.getMonth()).reduce((n,s)=>n+s.duration,0)/60*10)/10],['Needs summary',needs.length],['Reschedule requests',sessions.filter(s=>s.status==='Reschedule requested').length]].map(x=><div key={String(x[0])}><span>{x[0]}</span><strong>{x[1]}</strong></div>)}</div><Notice warning>{verified?'Calendar and managed video are not connected.':'Your mentor profile is under review. Session booking, joining and changes are disabled.'}</Notice><div className={styles.toolbar}><nav className={styles.tabs}>{['Upcoming','Needs summary','Past','Calendar'].map(t=><button className={tab===t?styles.tabActive:styles.tab} onClick={()=>setTab(t)} key={t}>{t}{t==='Needs summary'&&needs.length>0?` · ${needs.length}`:''}</button>)}</nav><label className={styles.search}><Search size={13}/><input value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search startup or topic"/></label><Button onClick={exportCsv} disabled={tab!=='Past'}><Download size={12}/> Export CSV</Button></div><div className={styles.twoColumn}><main className={styles.stack}>{tab==='Calendar'?<div className={styles.card}><div className={styles.cardHead}><div><h3>Week calendar</h3><p>Sessions remain available as a list below.</p></div><div className={styles.inlineActions}><Button onClick={()=>setWeek(w=>w-1)}>Previous</Button><Button onClick={()=>setWeek(0)}>Today</Button><Button onClick={()=>setWeek(w=>w+1)}>Next</Button></div></div><div className={styles.weekCalendar}>{days.map(day=><div key={day.toISOString()}><strong>{day.toLocaleDateString('en-IN',{weekday:'short'})}</strong><small>{day.toLocaleDateString('en-IN',{day:'numeric',month:'short'})}</small>{sessions.filter(s=>new Date(s.date).toDateString()===day.toDateString()).map(s=><Link href={`/mentor/sessions/${s.id}`} key={s.id}>{new Date(s.date).toLocaleTimeString('en-IN',{hour:'numeric',minute:'2-digit'})} · {s.topic}</Link>)}</div>)}</div><small className={styles.caption}>Availability blocks and conflicts are not synced.</small></div>:list.length?list.map(s=><MentorSessionCard key={s.id} session={s} verified={verified} action={tab==='Needs summary'?'Add summary':'Open'} onStatus={updateStatus}/>):<Empty title={tab==='Needs summary'?'No session summaries are waiting.':tab==='Past'?'No past sessions.':'No sessions scheduled.'} detail={tab==='Upcoming'?'Book from an active startup workspace after verification; calendar invitations are unavailable.':tab==='Needs summary'?'Completed sessions without a summary would appear here.':'No session records are available in this browser.'} action="Open My Startups" href="#mentor-startups"/>}</main><aside className={styles.stack}><Card title="Today" subtitle="Asia/Kolkata">{sessions.filter(s=>new Date(s.date).toDateString()===now.toDateString()).length?sessions.filter(s=>new Date(s.date).toDateString()===now.toDateString()).map(s=><MentorSessionCard key={s.id} session={s} verified={verified} action="Prepare" onStatus={updateStatus}/>):<p className={styles.emptyText}>No sessions today.</p>}</Card><Card title="Availability this week"><p className={styles.emptyText}>Open slots: not connected</p><Link className={styles.textLink} href="#mentor-settings">Edit availability <ArrowRight size={12}/></Link></Card><Card title="Hours vs capacity"><p className={styles.emptyText}>Capacity: not connected to session billing or availability.</p></Card></aside></div></section>
}
function MentorSessionCard({session,verified,action,onStatus}:{session:MentorRoleSession&{startupName:string;startupId:string};verified:boolean;action:string;onStatus:(id:string,status:MentorRoleSession['status'])=>void}){const diff=new Date(session.date).getTime()-Date.now();const withinTen=diff>=0&&diff<=10*60000;const soon=diff>0&&diff<30*60000;return <article className={`${styles.sessionCard} ${soon?styles.sessionSoon:''}`}><span className={styles.sessionDate}><CalendarDays size={14}/><strong>{new Date(session.date).toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'short'})}</strong><small>{new Date(session.date).toLocaleTimeString('en-IN',{hour:'numeric',minute:'2-digit'})} {session.timezone||'IST'}</small></span><div className={styles.sessionInfo}><strong>{session.startupName} · {session.topic}</strong><small>{session.duration} min · {session.type||'Regular'} · {session.attendees?.join(', ')||'No attendee list'}</small><Status value={session.status}/></div><div className={styles.inlineActions}><Link className={styles.secondary} href={`/mentor/sessions/${session.id}`}>{action}</Link><Button disabled={!verified||!withinTen} title={!verified?'Verification required':'Join opens 10 minutes before start'}><Video size={12}/> Join</Button><Button disabled={!verified||!['Scheduled','Confirmed'].includes(session.status)} onClick={()=>onStatus(session.id,'Reschedule requested')}>Reschedule</Button></div></article>}
function SessionDetailSection({data,setData,sessionId,notify}:{data:MentorRoleData;setData:React.Dispatch<React.SetStateAction<MentorRoleData>>;sessionId?:string;notify:(s:string)=>void}){
 const found=sessionId?data.startups.flatMap(startup=>startup.sessions.map(session=>({...session,startupName:startup.startupName,startupId:startup.id,statusMentorship:startup.status}))).find(s=>s.id===sessionId):undefined;
 const [tab,setTab]=useState('Agenda');const [summary,setSummary]=useState(found?.notes||'');const [decisions,setDecisions]=useState(found?.decisions||'');const [privateNotes,setPrivateNotes]=useState(found?.privateNotes||'');const [progress,setProgress]=useState(found?.progress||'On track');const verified=data.verifiedStatus==='Verified';
 const update=(patch:Partial<MentorRoleSession>)=>found&&setData(d=>({...d,startups:d.startups.map(st=>st.id===found.startupId?{...st,sessions:st.sessions.map(s=>s.id===found.id?{...s,...patch}:s)}:st)}));
 const saveSummary=(e:FormEvent)=>{e.preventDefault();if(summary.trim().length<20){notify('Summary must be at least 20 characters.');return}update({notes:summary,decisions,privateNotes,progress,status:'Completed',sharedSummary:true});notify('Summary saved in the local record; startup was not notified.')};
 if(!sessionId)return <section id="mentor-session-detail" className={styles.rollSection}><SectionHeader title="Session detail" subtitle="Open a session from the Sessions list to review its agenda, notes and summary."/><Empty title="No session selected." detail="Session records are not connected to this mentor account." action="View sessions" href="#mentor-sessions"/></section>;
 if(!found)return <section id="mentor-session-detail" className={styles.rollSection}><SectionHeader title="Session not found" subtitle="Session details are limited to assigned mentorship records."/><Notice warning>No session data was loaded for this ID. The route does not expose unassigned startup data.</Notice><Empty title="This session is unavailable." detail="It may not belong to this mentor or isn't present in the local workspace." action="Sessions" href="/mentor/sessions"/></section>;
 const tabs=['Agenda','Notes','Files','Recording','Summary and feedback'];const live=found.status==='Confirmed'&&new Date(found.date).getTime()<=Date.now()&&new Date(found.date).getTime()+found.duration*60000>Date.now();return <section id="mentor-session-detail" className={styles.rollSection}><SectionHeader title={found.topic} subtitle={`${found.startupName} · ${new Date(found.date).toLocaleString('en-IN',{weekday:'long',day:'numeric',month:'short',hour:'numeric',minute:'2-digit'})} · ${found.timezone||'Asia/Kolkata'} · ${found.duration} minutes`}><Link className={styles.secondary} href={`/mentor/startups/${found.startupId}`}>Open workspace</Link><Button disabled={!verified||!(Date.now()>=new Date(found.date).getTime()-10*60000&&Date.now()<=new Date(found.date).getTime()+found.duration*60000)}><Video size={13}/>{live?'Return to session':'Join session'}</Button></SectionHeader><Notice warning>{verified?'Managed video, calendar and recording are not connected.':'Verification pending: joining, session changes and summary submission are disabled.'}</Notice><div className={styles.workspaceTop}><span className={styles.startupLogo}>{found.startupName.slice(0,1)}</span><div><strong>{found.startupName}</strong><small>{found.type||'Regular'} · {found.attendees?.join(', ')||'Attendees not shared'}</small></div><Status value={found.status}/></div><nav className={styles.tabs}>{tabs.map(t=><button key={t} className={tab===t?styles.tabActive:styles.tab} onClick={()=>setTab(t)}>{t}</button>)}</nav><div className={styles.twoColumn}><main className={styles.stack}>{tab==='Agenda'?<><Card title="Shared agenda" subtitle="Editable only when the session service is connected.">{found.agendaItems?.length?found.agendaItems.map(a=><label className={styles.agendaItem} key={a.id}><input type="checkbox" checked={a.covered} disabled={!verified} onChange={e=>update({agendaItems:found.agendaItems?.map(x=>x.id===a.id?{...x,covered:e.target.checked}:x)})}/>{a.title}</label>):<Empty title="No agenda items." detail="No shared agenda has been provided."/>}</Card><Card title="Prep for you"><p className={styles.emptyText}>Last summary, open deliverables, sign-offs and shared files are not shared in this local record.</p><SharedData/></Card></>:tab==='Notes'?<Card title="Session notes"><label className={styles.field}>Shared notes<textarea value={summary} onChange={e=>setSummary(e.target.value)} maxLength={1000} placeholder="Collaborative notes (local only)"/></label><label className={styles.field}><span><LockKeyhole size={12}/> Private notes · never visible to startup</span><textarea value={privateNotes} onChange={e=>setPrivateNotes(e.target.value)} maxLength={10000}/></label><div className={styles.inlineActions}><Button disabled={!verified} onClick={()=>{update({notes:summary,privateNotes});notify('Notes saved locally; no startup notification.')}}>Save notes</Button><Button disabled>Create task</Button><Button disabled>Create deliverable</Button></div></Card>:tab==='Files'?<Card title="Session files"><Empty title="No files attached." detail="Only files explicitly shared by the startup should appear. Document access is not connected." action="Request a document"/></Card>:tab==='Recording'?<Card title="Recording"><div className={styles.sharedNotice}><LockKeyhole size={14}/><span>{found.recordingConsented?'Consent is recorded locally; no recording provider is connected.':'Recording was off. Both sides must consent before recording.'}</span></div></Card>:<><Card title="Mentor summary" subtitle="What we covered is required (20–1,000 characters). Save is local only."><form className={styles.stack} onSubmit={saveSummary}><label className={styles.field}>What we covered<textarea required minLength={20} maxLength={1000} rows={5} value={summary} onChange={e=>setSummary(e.target.value)} placeholder="Summarize the session and what you reviewed…"/></label><label className={styles.field}>Key decisions or advice<textarea value={decisions} onChange={e=>setDecisions(e.target.value)}/></label><label className={styles.field}>Progress since last session<select value={progress} onChange={e=>setProgress(e.target.value as typeof progress)}><option>On track</option><option>Behind</option><option>Ahead</option></select></label><label className={styles.checkLabel}><input type="checkbox" defaultChecked/> Share summary with startup</label><Button primary disabled={!verified||summary.trim().length<20}>Submit summary</Button></form><small className={styles.caption}>Submission would mark the session completed and notify the startup; those services aren't connected.</small></Card><Card title="Startup feedback"><p className={styles.emptyText}>{found.feedbackReceived||'Feedback is not yet shared.'}</p>{found.ratingReceived&&<p>Startup rating: {found.ratingReceived} / 5</p>}</Card></>}</main><aside className={styles.stack}><Card title="Session info"><div className={styles.sharedList}><div><span>Type</span><strong>{found.type||'Regular'}</strong></div><div><span>Timezone</span><strong>{found.timezone||'Asia/Kolkata'}</strong></div><div><span>Payment</span><strong>Not connected</strong></div></div></Card><Card title="Startup snapshot"><p className={styles.emptyText}>Stage, score, traction and sign-off progress are not shared in this record.</p></Card><Card title="Readiness items discussed"><Empty title="No items selected." detail="Readiness evidence is unavailable." action="Open sign-off" href={`/mentor/startups/${found.startupId}/readiness`}/></Card><Card title="Next session"><Button disabled={!verified}>Book follow-up</Button></Card></aside></div></section>
}
function SharedData(){return <div className={styles.sharedNotice}><LockKeyhole size={13}/><span>Shared by startup · no files or startup-only data are included.</span></div>}
function ReadinessSection({startup,mentorshipId,data,setData,notify}:{startup?:MentorStartup;mentorshipId?:string;data:MentorRoleData;setData:React.Dispatch<React.SetStateAction<MentorRoleData>>;notify:(s:string)=>void}){
 const [selected,setSelected]=useState<number|null>(null);const [tab,setTab]=useState('Awaiting you');const [note,setNote]=useState('');const [changeNote,setChangeNote]=useState('');const [conflict,setConflict]=useState(false);const [conflictNote,setConflictNote]=useState('');const [checks,setChecks]=useState<boolean[]>([]);const [due,setDue]=useState('');const verified=data.verifiedStatus==='Verified';const items=startup?.readinessItems||[];const signed=items.filter(i=>i.status==='Signed off').length;const pending=items.filter(i=>i.status==='Submitted');const filtered=tab==='Awaiting you'?pending:items;const updateItem=(index:number,patch:Partial<MentorStartup['readinessItems'][number]>)=>{if(!startup)return;setData(d=>({...d,startups:d.startups.map(s=>s.id===startup.id?{...s,readinessItems:s.readinessItems.map((x,i)=>i===index?{...x,...patch,updatedAt:new Date().toISOString()}:x)}:s)}))};const open=(i:number)=>{setSelected(i);const crit=items[i]?.criteria||[];setChecks(crit.map(()=>false));setNote('');setChangeNote('');setConflict(false);setConflictNote('')};const sign=()=>{if(selected===null)return;const item=items[selected];if(!note.trim()||note.trim().length<20||note.trim().length>500){notify('Sign-off note must be 20–500 characters.');return}if(!checks.length||checks.some(x=>!x)){notify('Review and check every published criterion before signing off.');return}if(!(item.evidence||[]).length){notify('A linked evidence item is required before sign-off.');return}if(conflict&&!conflictNote.trim()){notify('Add a conflict note; the item would route to admin review.');return}updateItem(selected,{status:conflict?'Pending admin review':'Signed off',note,updatedAt:new Date().toISOString()});setSelected(null);notify('Decision saved locally. No badge or startup notification was issued.')};const requestChanges=()=>{if(selected===null)return;if(changeNote.trim().length<20){notify('Change-request note must be at least 20 characters.');return}updateItem(selected,{status:'Changes requested',note:changeNote,updatedAt:new Date().toISOString()});setSelected(null);notify('Changes requested in the local record; startup was not notified.')};
 if(!mentorshipId)return <section id="mentor-readiness" className={styles.rollSection}><SectionHeader title="Readiness sign-off" subtitle="Review evidence item by item for one assigned startup."/><Empty title="Choose an assigned startup." detail="Readiness records are scoped to an active, paused or past mentorship." action="My startups" href="#mentor-startups"/></section>;
 if(!startup)return <section id="mentor-readiness" className={styles.rollSection}><SectionHeader title="Readiness sign-off unavailable"/><Notice warning>No readiness data was fetched for this mentorship ID.</Notice><Empty title="Mentorship not found." detail="The mentor does not have access to this startup record." action="My startups" href="/mentor/startups"/></section>;
 return <section id="mentor-readiness" className={styles.rollSection}><SectionHeader title={`${startup.startupName} · Readiness sign-off`} subtitle={`${startup.stage} · Shared evidence only`}><Link className={styles.secondary} href={`/mentor/startups/${startup.id}`}>Workspace</Link><Link className={styles.secondary} href={`/mentor/startups/${startup.id}/startup`}>View startup</Link></SectionHeader><Notice warning>{verified?'Sign-off decisions are saved locally only; audit and badge services are not connected.':'Your mentor profile is under review. Sign-off is disabled.'}</Notice><div className={styles.readinessHero}><div><span className={styles.sectionKicker}>Mentor sign-offs</span><h3>{signed} of {items.length} items signed off</h3><p>Badge status: {items.length&&signed===items.length?'All local items marked · badge service not connected':'Not yet · no badge will be issued here'}</p></div><div className={styles.readinessGauge}><span>—</span><small>Score not connected</small></div><Progress value={items.length?signed/items.length*100:0}/><small className={styles.caption}>No numeric readiness score is fabricated. A sign-off requires shared evidence and a written note.</small></div><div className={styles.twoColumn}><main className={styles.stack}><nav className={styles.tabs}>{['Awaiting you','All items'].map(t=><button key={t} className={tab===t?styles.tabActive:styles.tab} onClick={()=>setTab(t)}>{t}</button>)}</nav>{filtered.length?filtered.map(item=>{const ix=items.indexOf(item);return <article className={styles.readinessCard} key={item.id||item.title}><div className={styles.cardHead}><div><h3>{item.title}</h3><p>{item.criteria?.join(' · ')||'Published sign-off criteria are not available.'}</p></div><Status value={item.status}/></div><div className={styles.sharedNotice}><LockKeyhole size={13}/><span>{item.shared?'Shared by '+startup.startupName:'Not shared'}</span></div><p className={styles.emptyText}>Assigned mentor: {item.assignedMentor||'Not assigned'} · Updated {fmt(item.updatedAt||'')}</p><div className={styles.evidenceChips}>{item.evidence?.length?item.evidence.map((e,i)=><span key={i}><FileText size={12}/>{e}</span>):<small>No evidence linked. Sign-off stays unavailable.</small>}</div><div className={styles.inlineActions}><Button onClick={()=>open(ix)}>Review evidence</Button><Button primary disabled={!verified||item.status!=='Submitted'||item.assignedMentor!=='You'} onClick={()=>open(ix)}>Sign off</Button><Button disabled={!verified||item.status!=='Submitted'||item.assignedMentor!=='You'} onClick={()=>open(ix)}>Request changes</Button></div></article>}):<Empty title="Nothing is waiting for you." detail={`${startup.startupName} hasn't submitted readiness items for review.`} action="Message startup" href={`/mentor/startups/${startup.id}`}/>}</main><aside className={styles.stack}><Card title="Score breakdown"><p className={styles.emptyText}>Checklist completion: not connected</p><Progress value={0}/><p className={styles.emptyText}>Traction data: not shared</p><Progress value={0}/><p className={styles.emptyText}>Mentor feedback: not connected</p><Progress value={0}/></Card><Card title="Other mentors"><p className={styles.emptyText}>Mentor roster and item ownership are not shared.</p></Card><Card title="Timeline"><p className={styles.emptyText}>No decision history is connected.</p></Card><Card title="Guidance"><p className={styles.emptyText}>Sign off only evidence you reviewed. Never exchange a sign-off for payment, equity or other benefit.</p><Button onClick={()=>notify('Admin concern/report service is not connected.')}>Report a concern</Button></Card></aside></div>{selected!==null&&<div className={styles.modal}><section role="dialog" aria-modal="true" aria-labelledby="review-title"><header><div><span className={styles.sectionKicker}>Evidence review</span><h3 id="review-title">{items[selected].title}</h3></div><button className={styles.iconButton} onClick={()=>setSelected(null)} aria-label="Close"><X size={16}/></button></header><div className={styles.modalBody}><h4>What done means</h4>{(items[selected].criteria||[]).map((c,i)=><label className={styles.checkLabel} key={i}><input type="checkbox" checked={!!checks[i]} onChange={e=>setChecks(v=>v.map((x,j)=>j===i?e.target.checked:x))}/>{c}</label>)}{!(items[selected].criteria||[]).length&&<Notice warning>Criteria not shared; review cannot be completed.</Notice>}<h4>Evidence · view only</h4>{items[selected].evidence?.length?items[selected].evidence.map((e,i)=><div className={styles.evidenceRow} key={i}><FileText size={13}/>{e}<span>Shared by {startup.startupName}</span></div>):<Notice warning>No evidence attached. Sign-off is blocked.</Notice>}<Field label="Sign-off note · 20–500 characters"><textarea maxLength={500} value={note} onChange={e=>setNote(e.target.value)} placeholder="What you reviewed and why it passes"/></Field><Field label="Changes requested · 20–1,000 characters"><textarea maxLength={1000} value={changeNote} onChange={e=>setChangeNote(e.target.value)} placeholder="What is missing and suggested next steps"/></Field><Field label="Suggested due date"><input type="date" value={due} onChange={e=>setDue(e.target.value)}/></Field><label className={styles.checkLabel}><input type="checkbox" checked={!conflict} onChange={e=>setConflict(!e.target.checked)}/> I have no conflict of interest on this item</label>{conflict&&<Field label="Conflict note"><textarea value={conflictNote} onChange={e=>setConflictNote(e.target.value)}/></Field>}<Notice warning>You confirm you reviewed the evidence. In production, sign-offs are named, dated and visible to investors.</Notice><div className={styles.inlineActions}><Button onClick={()=>setSelected(null)}>Cancel</Button><Button disabled>Not applicable · admin review required</Button><Button disabled={!verified||changeNote.trim().length<20} onClick={requestChanges}>Request changes</Button><Button primary disabled={!verified||note.trim().length<20||!checks.length||checks.some(x=>!x)||!(items[selected].evidence||[]).length} onClick={sign}>Confirm sign-off</Button></div></div></section></div>}</section>
}
