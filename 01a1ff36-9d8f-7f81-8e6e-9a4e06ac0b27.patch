+                    ]
+                ),
+            )
+        )
+    ).scalar_one()
+    intro_requests = (
+        await db.execute(
+            select(func.count())
+            .select_from(InvestorEngagementRequest)
+            .where(
+                InvestorEngagementRequest.investor_org_id == org.id,
+                InvestorEngagementRequest.deleted_at.is_(None),
+            )
+        )
+    ).scalar_one()
+    data_rooms_opened = (
+        await db.execute(
+            select(func.count())
+            .select_from(InvestorDeal)
+            .where(
+                InvestorDeal.investor_org_id == org.id,
