@@ -0,0 +1,219 @@
+"""Investor offer schemas (Step 9i).
+
+Strict ``extra="forbid"`` Create/Update/Counter schemas (AGENTS.md
+section 7): server-controlled fields (``id``, ``investor_org_id``,
+``round_id`` context, ``version``, ``parent_offer_id``, ``status``,
+``created_at``, ``updated_at``, ``deleted_at``) are never inputs.
+Status changes only happen through the dedicated transition endpoints
+(send / counter / withdraw / accept / decline), never a free-form
+update (BUILD_PLAN 9i note).
+
+The startup-side read (``StartupOfferRead``) deliberately STRIPS the
+investor's private fields — ``notes`` and ``owner_id`` — so a startup
+can never see an investor's internal notes through the offer view
+(BUILD_PLAN confidentiality rule).
+
+Money: ``NUMERIC(14,2)`` -> ``Decimal`` with ``decimal_places=2`` (the
+5e ``MetricRead`` pattern); ``discount_pct`` is 0-100.
+"""
+
+import uuid
+from datetime import date, datetime
+from decimal import Decimal
+
+from pydantic import BaseModel, ConfigDict, Field, field_validator
+
+from app.models.investor_offer import OfferStatus
+
+_INSTRUMENTS = frozenset(
+    {"equity", "safe", "convertible_note", "ccd", "ccps", "debt", "other"}
+)
+
+
+def _check_instrument(v: str | None) -> str | None:
+    if v is None:
+        return v
+    if v not in _INSTRUMENTS:
+        raise ValueError(
+            "instrument must be one of equity, safe, convertible_note, "
+            "ccd, ccps, debt, other"
+        )
+    return v
+
+
+class InvestorOfferCreate(BaseModel):
+    """Create offer version v1 (status ``draft``).
+
+    ``investor_org_id`` is the caller's own firm (resolved server-side
+    from membership), never an input. ``owner_id`` must be an active
+    member of that firm (validated in the service).
+    """
+
+    model_config = ConfigDict(extra="forbid")
+
+    round_id: uuid.UUID
+    amount: Decimal = Field(gt=0, decimal_places=2)
+    currency: str = Field(default="INR", max_length=3)
+    instrument: str
+    valuation_cap: Decimal | None = Field(default=None, decimal_places=2)
+    discount_pct: Decimal | None = Field(default=None, ge=0, le=100, decimal_places=2)
+    expires_on: date | None = None
+    owner_id: uuid.UUID | None = None
+    notes: str | None = None
+
+    _instrument_valid = field_validator("instrument")(_check_instrument)
+
+
+class InvestorOfferUpdate(BaseModel):
+    """Editable offer fields (PATCH). ``status``/``version`` are NOT
+    writable — transitions go through the dedicated endpoints."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    amount: Decimal | None = Field(default=None, gt=0, decimal_places=2)
+    currency: str | None = Field(default=None, max_length=3)
+    instrument: str | None = None
+    valuation_cap: Decimal | None = Field(default=None, decimal_places=2)
+    discount_pct: Decimal | None = Field(default=None, ge=0, le=100, decimal_places=2)
+    expires_on: date | None = None
+    owner_id: uuid.UUID | None = None
+    notes: str | None = None
+
+    _instrument_valid = field_validator("instrument")(_check_instrument)
+
+
+class InvestorOfferCounter(BaseModel):
+    """Counter terms for the next offer version (status ``countered``).
+
+    The new row copies ``round_id`` / ``investor_org_id`` from the
+    parent, takes ``version`` = parent.version + 1 and
+    ``parent_offer_id`` = the parent's id (all server-controlled).
+    """
+
+    model_config = ConfigDict(extra="forbid")
+
+    amount: Decimal = Field(gt=0, decimal_places=2)
+    currency: str = Field(default="INR", max_length=3)
+    instrument: str
+    valuation_cap: Decimal | None = Field(default=None, decimal_places=2)
+    discount_pct: Decimal | None = Field(default=None, ge=0, le=100, decimal_places=2)
+    expires_on: date | None = None
+    owner_id: uuid.UUID | None = None
+    notes: str | None = None
+
+    _instrument_valid = field_validator("instrument")(_check_instrument)
+
+
+class InvestorOfferRead(BaseModel):
+    """Full offer version as the investor sees it (with startup + round
+    snapshot, so the board renders without a second request)."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    id: uuid.UUID
+    round_id: uuid.UUID
+    investor_org_id: uuid.UUID
+    startup_org_id: uuid.UUID
+    startup_name: str
+    startup_slug: str
+    startup_logo_initials: str | None
+    startup_logo_url: str | None
+    startup_sector: str | None
+    startup_tagline: str | None
+    round_target: Decimal | None
+    round_currency: str | None
+    amount: Decimal
+    currency: str
+    instrument: str
+    valuation_cap: Decimal | None
+    discount_pct: Decimal | None
+    version: int
+    parent_offer_id: uuid.UUID | None
+    status: OfferStatus
+    expires_on: date | None
+    owner_id: uuid.UUID | None
+    owner_name: str | None
+    notes: str | None
+    created_at: datetime
+    updated_at: datetime
+
+
+class InvestorOfferPage(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    items: list[InvestorOfferRead]
+    total: int
+    limit: int
+    offset: int
+
+
+class OfferVersionItem(BaseModel):
+    """One version row of an offer's version chain."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    id: uuid.UUID
+    version: int
+    amount: Decimal
+    currency: str
+    instrument: str
+    valuation_cap: Decimal | None
+    discount_pct: Decimal | None
+    status: OfferStatus
+    parent_offer_id: uuid.UUID | None
+    created_at: datetime
+    updated_at: datetime
+
+
+class OfferHistoryPage(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    items: list[OfferVersionItem]
+    total: int
+    limit: int
+    offset: int
+
+
+class StartupOfferRead(BaseModel):
+    """An offer as the STARTUP sees it: investor-private fields stripped
+    (``notes``, ``owner_id``)."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    id: uuid.UUID
+    investor_org_id: uuid.UUID
+    investor_name: str
+    investor_slug: str
+    round_id: uuid.UUID
+    amount: Decimal
+    currency: str
+    instrument: str
+    valuation_cap: Decimal | None
+    discount_pct: Decimal | None
+    version: int
+    status: OfferStatus
+    expires_on: date | None
+    created_at: datetime
+    updated_at: datetime
+
+
+class StartupOfferPage(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    items: list[StartupOfferRead]
+    total: int
+    limit: int
+    offset: int
+
+
+__all__ = [
+    "InvestorOfferCreate",
+    "InvestorOfferCounter",
+    "InvestorOfferPage",
+    "InvestorOfferRead",
+    "InvestorOfferUpdate",
+    "OfferHistoryPage",
+    "OfferVersionItem",
+    "StartupOfferPage",
+    "StartupOfferRead",
+]
diff --git a/backend/app/schemas/investor_workspace.py b/backend/app/schemas/investor_workspace.py
new file mode 100644
index 0000000..1a2ca2d
--- /dev/null
+++ b/backend/app/schemas/investor_workspace.py
@@ -0,0 +1,136 @@
+"""Pydantic schemas for the investor workspace (Step 9l).
+
+Read-only aggregation responses — no write schemas, so no
+``extra="forbid"`` concerns. Shapes derive from the frontend pages
+(``/investor/dashboard``, ``/investor/insights``,
+``/investor/activity``).
+
+D1 (9l): insights are DESCRIPTIVE only — counts and distributions
+over real data, cohort threshold n >= 10, no forecasts or
+predictions.
+"""
+
+import uuid
+from datetime import date, datetime
+
+from pydantic import BaseModel, ConfigDict
+
+
+# ---------------------------------------------------------------------------
+# Dashboard summary
+# ---------------------------------------------------------------------------
+class NeedsReplyItem(BaseModel):
+    """One 'needs your reply' entry (from pending engagement requests)."""
+
+    id: uuid.UUID
+    startup_org_id: uuid.UUID
+    startup_name: str
+    kind: str
+    ask: str
+    created_at: datetime
+
+
+class UpcomingMeetingItem(BaseModel):
+    """One 'upcoming meetings' entry."""
+
+    id: uuid.UUID
+    startup_org_id: uuid.UUID
+    startup_name: str
+    meeting_type: str
+    scheduled_at: datetime
+    status: str
+
+
+class DashboardSummary(BaseModel):
+    """The dashboard top stat strip + sidebar cards (9l)."""
+
+    new_matches_this_week: int
+    requests_awaiting_reply: int
+    meetings_this_week: int
+    startups_in_pipeline: int
+    pipeline_snapshot: dict[str, int]
+    portfolio_holdings: int
+    portfolio_updates_this_week: int
+    needs_reply: list[NeedsReplyItem]
+    upcoming_meetings: list[UpcomingMeetingItem]
+
+
+# ---------------------------------------------------------------------------
+# Insights
+# ---------------------------------------------------------------------------
+class MonthlyCount(BaseModel):
+    month: str  # ISO YYYY-MM
+    count: int
+
+
+class YourFunnelStats(BaseModel):
+    """Private-to-you funnel counts (descriptive, no predictions)."""
+
+    profiles_reviewed: int
+    shortlisted: int
+    intro_requests: int
+    data_rooms_opened: int
+    offers_extended: int
+
+
+class InsightsResponse(BaseModel):
+    """Descriptive platform + private-funnel stats (9l, D1: no forecasts)."""
+
+    startups_by_stage: dict[str, int]
+    startups_by_stage_total: int
+    monthly_new_profiles: list[MonthlyCount]
+    monthly_round_launches: list[MonthlyCount]
+    your_funnel: YourFunnelStats
+    cohort_threshold: int
+
+
+# ---------------------------------------------------------------------------
+# Activity
+# ---------------------------------------------------------------------------
+class ActivityEventRead(BaseModel):
+    model_config = ConfigDict(from_attributes=True)
+
+    id: int
+    org_id: uuid.UUID | None
+    user_id: uuid.UUID | None
+    event_type: str
+    entity_type: str | None
+    entity_id: uuid.UUID | None
+    summary: str
+    link_url: str | None
+    created_at: datetime
+
+
+class ActivityPage(BaseModel):
+    items: list[ActivityEventRead]
+    total: int
+    limit: int
+    offset: int
+
+
+class DailyCount(BaseModel):
+    day: date
+    count: int
+
+
+class ActivityStats(BaseModel):
+    """Aggregate activity stats for the investor's org (9l)."""
+
+    total_events: int
+    events_last_7_days: int
+    by_event_type: dict[str, int]
+    by_day: list[DailyCount]
+
+
+__all__ = [
+    "ActivityEventRead",
+    "ActivityPage",
+    "ActivityStats",
+    "DashboardSummary",
+    "DailyCount",
+    "InsightsResponse",
+    "MonthlyCount",
+    "NeedsReplyItem",
+    "UpcomingMeetingItem",
+    "YourFunnelStats",
+]
diff --git a/backend/app/services/commitment_service.py b/backend/app/services/commitment_service.py
new file mode 100644
index 0000000..a18904b
--- /dev/null
+++ b/backend/app/services/commitment_service.py
@@ -0,0 +1,639 @@
+"""Step 9j service: commitments and portfolio holdings.
+
+Authorization follows the 9e/9i precedent, one check per operation:
+
+- **Investor side** (``/investors/commitments``, ``/investors/portfolio``):
+  resolve the caller's active ``investor_firm`` org first
+  (``_investor_org_or_404``). Reads: any active member. Writes:
+  owner/admin/member (viewer 403). Rows are org-scoped — another firm's
+  commitment or holding is a 404 (no existence oracle).
+
+Status lifecycles (plan D1/D14 pattern): commitments
+``pledged -> documented -> funded`` with ``cancelled`` reachable from
+any non-terminal state; holdings ``active -> written_off`` /
+``exited`` / ``partially_exited``. Transitions are validated against
+``COMMITMENT_TRANSITIONS`` / ``HOLDING_TRANSITIONS``; terminal states are
+rejected with 409. Status is never writable via PATCH.
+
+``commitments`` has NO ``deleted_at`` (schema.sql): cancellation is a
+status. Creating a commitment adds its amount to the round's
+``committed_amount`` (the 9a plan D2 promise that 9i/9j write it);
+cancelling subtracts it back, floored at zero.
+
+Every mutation writes an ``activity_events`` row in the SAME
+transaction (the 5i/9e pattern).
+
+Money: ``NUMERIC(14,2)`` -> ``Decimal``; ``ownership_pct`` 0-100.
+"""
+
+import uuid
+from datetime import UTC, date, datetime
+from decimal import Decimal
+
+from sqlalchemy import func, select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.core.config import get_settings
+from app.core.exceptions import conflict, not_found, rate_limited, validation_error
+from app.models.activity import ActivityEventType
+from app.models.commitment import (
+    COMMITMENT_TRANSITIONS,
+    HOLDING_TRANSITIONS,
+    Commitment,
+    CommitmentStatus,
+    PortfolioHolding,
+)
+from app.models.funding_round import FundingRound
+from app.models.organization import (
+    MemberStatus,
+    Organization,
+    OrganizationMember,
+    OrgRole,
+    OrgType,
+)
+from app.models.startup import StartupProfile
+from app.models.user import User
+from app.schemas.commitment import (
+    CommitmentCreate,
+    CommitmentRead,
+    CommitmentUpdate,
+    HoldingCreate,
+    HoldingRead,
+    HoldingUpdate,
+)
+from app.services import activity_service, organization_service, rate_limiter
+
+# Org roles allowed to write investor-side data. Viewers are read-only.
+WRITE_ROLES = {OrgRole.owner, OrgRole.admin, OrgRole.member}
+
+
+async def _enforce_commitment_write_limit(user: User) -> None:
+    settings = get_settings()
+    if not await rate_limiter.rate_limiter.check(
+        f"commitment_write:user:{user.id}",
+        settings.COMMITMENT_WRITE_LIMIT,
+        settings.COMMITMENT_WRITE_WINDOW_SECONDS,
+    ):
+        raise rate_limited("Too many commitment changes. Please slow down.")
+
+
+async def _enforce_portfolio_write_limit(user: User) -> None:
+    settings = get_settings()
+    if not await rate_limiter.rate_limiter.check(
+        f"portfolio_write:user:{user.id}",
+        settings.PORTFOLIO_WRITE_LIMIT,
+        settings.PORTFOLIO_WRITE_WINDOW_SECONDS,
+    ):
+        raise rate_limited("Too many holding changes. Please slow down.")
+
+
+async def _investor_org_or_404(db: AsyncSession, user: User) -> Organization:
+    """The caller's active ``investor_firm`` organization, or 404."""
+    result = await db.execute(
+        select(Organization)
+        .join(OrganizationMember, OrganizationMember.org_id == Organization.id)
+        .where(
+            OrganizationMember.user_id == user.id,
+            OrganizationMember.deleted_at.is_(None),
+            OrganizationMember.status == MemberStatus.active,
+            Organization.type == OrgType.investor_firm,
+            Organization.status == "active",
+            Organization.deleted_at.is_(None),
+        )
+        .order_by(OrganizationMember.joined_at)
+    )
+    org = result.scalars().first()
+    if org is None:
+        raise not_found(
+            "No investor organization found for this account.",
+            code="INVESTOR_ORG_NOT_FOUND",
+        )
+    return org
+
+
+async def _require_member(
+    db: AsyncSession, org: Organization, user: User, *, write: bool
+) -> None:
+    if write:
+        await organization_service.require_membership(
+            db, org.id, user, roles=WRITE_ROLES
+        )
+    else:
+        await organization_service.require_membership(db, org.id, user)
+
+
+async def _round_or_404(db: AsyncSession, round_id: uuid.UUID) -> FundingRound:
+    result = await db.execute(
+        select(FundingRound).where(
+            FundingRound.id == round_id,
+            FundingRound.deleted_at.is_(None),
+        )
+    )
+    round_ = result.scalar_one_or_none()
+    if round_ is None:
+        raise validation_error(
+            "round_id must reference a live funding round.",
+            details=[{"loc": ["body", "round_id"], "msg": "Invalid round.", "type": "value_error"}],
+        )
+    return round_
+
+
+async def _validate_offer_ref(
+    db: AsyncSession, investor_org_id: uuid.UUID, offer_id: uuid.UUID | None, round_id: uuid.UUID
+) -> None:
+    """An offer_id, if given, must be a live offer of THIS firm on THIS
+    round."""
+    if offer_id is None:
+        return
+    from app.models.investor_offer import InvestorOffer
+
+    result = await db.execute(
+        select(InvestorOffer.id).where(
+            InvestorOffer.id == offer_id,
+            InvestorOffer.investor_org_id == investor_org_id,
+            InvestorOffer.round_id == round_id,
+            InvestorOffer.deleted_at.is_(None),
+        )
+    )
+    if result.first() is None:
+        raise validation_error(
+            "offer_id must be a live offer of this firm on the round.",
+            details=[{"loc": ["body", "offer_id"], "msg": "Invalid offer.", "type": "value_error"}],
+        )
+
+
+def _check_commitment_transition(
+    current: CommitmentStatus, target: CommitmentStatus
+) -> None:
+    if target not in COMMITMENT_TRANSITIONS.get(current, frozenset()):
+        raise conflict(
+            f"Cannot move a commitment from {current.value} to {target.value}."
+        )
+
+
+def _check_holding_transition(current: str, target: str) -> None:
+    if target not in HOLDING_TRANSITIONS.get(current, frozenset()):
+        raise conflict(
+            f"Cannot move a holding from {current} to {target}."
+        )
+
+
+async def _startup_snapshot(
+    db: AsyncSession, startup_org_id: uuid.UUID
+) -> tuple[Organization, StartupProfile | None]:
+    startup = await organization_service.org_or_404(db, startup_org_id)
+    profile = (
+        await db.execute(
+            select(StartupProfile).where(StartupProfile.org_id == startup.id)
+        )
+    ).scalar_one_or_none()
+    return startup, profile
+
+
+def _as_commitment_read(
+    commitment: Commitment,
+    startup: Organization,
+    profile: StartupProfile | None,
+    round_: FundingRound | None,
+) -> CommitmentRead:
+    return CommitmentRead(
+        id=commitment.id,
+        round_id=commitment.round_id,
+        offer_id=commitment.offer_id,
+        investor_org_id=commitment.investor_org_id,
+        startup_org_id=startup.id,
+        startup_name=startup.name,
+        startup_slug=startup.slug,
+        startup_logo_initials=startup.logo_initials,
+        startup_logo_url=startup.logo_url,
+        startup_sector=profile.sector if profile else None,
+        startup_tagline=profile.tagline if profile else None,
+        round_target=round_.target_amount if round_ else None,
+        round_currency=round_.currency if round_ else None,
+        amount=commitment.amount,
+        currency=commitment.currency,
+        status=commitment.status,
+        committed_on=commitment.committed_on,
+        funded_on=commitment.funded_on,
+        wired_at=commitment.wired_at,
+        reference=commitment.reference,
+        created_at=commitment.created_at,
+        updated_at=commitment.updated_at,
+    )
+
+
+def _as_holding_read(
+    holding: PortfolioHolding,
+    startup: Organization,
+    profile: StartupProfile | None,
+) -> HoldingRead:
+    return HoldingRead(
+        id=holding.id,
+        investor_org_id=holding.investor_org_id,
+        startup_org_id=holding.startup_org_id,
+        startup_name=startup.name,
+        startup_slug=startup.slug,
+        startup_logo_initials=startup.logo_initials,
+        startup_logo_url=startup.logo_url,
+        startup_sector=profile.sector if profile else None,
+        startup_tagline=profile.tagline if profile else None,
+        commitment_id=holding.commitment_id,
+        instrument=holding.instrument,
+        invested_amount=holding.invested_amount,
+        currency=holding.currency,
+        ownership_pct=holding.ownership_pct,
+        invested_on=holding.invested_on,
+        status=holding.status,
+        exited_on=holding.exited_on,
+        exit_value=holding.exit_value,
+        created_at=holding.created_at,
+        updated_at=holding.updated_at,
+    )
+
+
+# --- commitments -----------------------------------------------------------
+
+
+async def _commitment_or_404(
+    db: AsyncSession, commitment_id: uuid.UUID, investor_org_id: uuid.UUID
+) -> Commitment:
+    result = await db.execute(
+        select(Commitment).where(
+            Commitment.id == commitment_id,
+            Commitment.investor_org_id == investor_org_id,
+        )
+    )
+    commitment = result.scalar_one_or_none()
+    if commitment is None:
+        raise not_found("Commitment not found.")
+    return commitment
+
+
+async def list_commitments(
+    db: AsyncSession,
+    user: User,
+    *,
+    status: CommitmentStatus | None,
+    limit: int,
+    offset: int,
+) -> tuple[list[CommitmentRead], int]:
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=False)
+
+    stmt = (
+        select(Commitment, Organization, StartupProfile, FundingRound)
+        .join(FundingRound, FundingRound.id == Commitment.round_id)
+        .join(Organization, Organization.id == FundingRound.org_id)
+        .outerjoin(StartupProfile, StartupProfile.org_id == Organization.id)
+        .where(Commitment.investor_org_id == org.id)
+    )
+    if status is not None:
+        stmt = stmt.where(Commitment.status == status)
+
+    total = (
+        await db.execute(select(func.count()).select_from(stmt.subquery()))
+    ).scalar_one()
+    rows = (
+        await db.execute(
+            stmt.order_by(Commitment.updated_at.desc(), Commitment.id.desc())
+            .limit(limit)
+            .offset(offset)
+        )
+    ).all()
+    return [
+        _as_commitment_read(c, startup, profile, round_)
+        for c, startup, profile, round_ in rows
+    ], int(total)
+
+
+async def get_commitment(
+    db: AsyncSession, user: User, commitment_id: uuid.UUID
+) -> CommitmentRead:
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=False)
+    commitment = await _commitment_or_404(db, commitment_id, org.id)
+    round_ = await _round_or_404(db, commitment.round_id)
+    startup, profile = await _startup_snapshot(db, round_.org_id)
+    return _as_commitment_read(commitment, startup, profile, round_)
+
+
+async def create_commitment(
+    db: AsyncSession, user: User, payload: CommitmentCreate
+) -> CommitmentRead:
+    await _enforce_commitment_write_limit(user)
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=True)
+
+    round_ = await _round_or_404(db, payload.round_id)
+    await _validate_offer_ref(db, org.id, payload.offer_id, payload.round_id)
+
+    commitment = Commitment(
+        round_id=payload.round_id,
+        offer_id=payload.offer_id,
+        investor_org_id=org.id,
+        amount=payload.amount,
+        currency=payload.currency,
+        status=CommitmentStatus.pledged,
+        committed_on=payload.committed_on,
+        reference=payload.reference,
+    )
+    db.add(commitment)
+    await db.flush()
+
+    # 9a plan D2: commitments write the round's committed_amount.
+    round_.committed_amount = (round_.committed_amount or Decimal("0")) + payload.amount
+
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.commitment_created,
+        org_id=org.id,
+        actor_id=user.id,
+        entity_type="commitment",
+        entity_id=commitment.id,
+        summary=(
+            f"{user.display_name or 'An investor'} pledged "
+            f"{commitment.amount} {commitment.currency}."
+        ),
+    )
+    await db.commit()
+    await db.refresh(commitment)
+    startup, profile = await _startup_snapshot(db, round_.org_id)
+    return _as_commitment_read(commitment, startup, profile, round_)
+
+
+async def update_commitment(
+    db: AsyncSession, user: User, commitment_id: uuid.UUID, payload: CommitmentUpdate
+) -> CommitmentRead:
+    await _enforce_commitment_write_limit(user)
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=True)
+    commitment = await _commitment_or_404(db, commitment_id, org.id)
+
+    if payload.reference is not None:
+        commitment.reference = payload.reference
+    if payload.committed_on is not None:
+        commitment.committed_on = payload.committed_on
+
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.commitment_updated,
+        org_id=org.id,
+        actor_id=user.id,
+        entity_type="commitment",
+        entity_id=commitment.id,
+        summary=f"{user.display_name or 'An investor'} updated the commitment.",
+    )
+    await db.commit()
+    await db.refresh(commitment)
+    round_ = await _round_or_404(db, commitment.round_id)
+    startup, profile = await _startup_snapshot(db, round_.org_id)
+    return _as_commitment_read(commitment, startup, profile, round_)
+
+
+async def transition_commitment(
+    db: AsyncSession, user: User, commitment_id: uuid.UUID, target: CommitmentStatus
+) -> CommitmentRead:
+    await _enforce_commitment_write_limit(user)
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=True)
+    commitment = await _commitment_or_404(db, commitment_id, org.id)
+
+    _check_commitment_transition(commitment.status, target)
+    previous = commitment.status
+    commitment.status = target
+    if target == CommitmentStatus.funded:
+        # Wiring is a server-side fact: stamp the timestamp and date.
+        commitment.wired_at = datetime.now(UTC)
+        if commitment.funded_on is None:
+            commitment.funded_on = commitment.wired_at.date()
+    if target == CommitmentStatus.cancelled:
+        # Undo the round progress this pledge contributed.
+        round_ = await _round_or_404(db, commitment.round_id)
+        round_.committed_amount = max(
+            Decimal("0"), (round_.committed_amount or Decimal("0")) - commitment.amount
+        )
+
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.commitment_status_changed,
+        org_id=org.id,
+        actor_id=user.id,
+        entity_type="commitment",
+        entity_id=commitment.id,
+        summary=(
+            f"{user.display_name or 'An investor'} moved the commitment "
+            f"from {previous.value} to {target.value}."
+        ),
+    )
+    await db.commit()
+    await db.refresh(commitment)
+    round_ = await _round_or_404(db, commitment.round_id)
+    startup, profile = await _startup_snapshot(db, round_.org_id)
+    return _as_commitment_read(commitment, startup, profile, round_)
+
+
+# --- portfolio holdings ----------------------------------------------------
+
+
+async def _holding_or_404(
+    db: AsyncSession, holding_id: uuid.UUID, investor_org_id: uuid.UUID
+) -> PortfolioHolding:
+    result = await db.execute(
+        select(PortfolioHolding).where(
+            PortfolioHolding.id == holding_id,
+            PortfolioHolding.investor_org_id == investor_org_id,
+        )
+    )
+    holding = result.scalar_one_or_none()
+    if holding is None:
+        raise not_found("Holding not found.")
+    return holding
+
+
+async def list_holdings(
+    db: AsyncSession,
+    user: User,
+    *,
+    status: str | None,
+    limit: int,
+    offset: int,
+) -> tuple[list[HoldingRead], int]:
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=False)
+
+    stmt = (
+        select(PortfolioHolding, Organization, StartupProfile)
+        .join(Organization, Organization.id == PortfolioHolding.startup_org_id)
+        .outerjoin(StartupProfile, StartupProfile.org_id == Organization.id)
+        .where(PortfolioHolding.investor_org_id == org.id)
+    )
+    if status is not None:
+        stmt = stmt.where(PortfolioHolding.status == status)
+
+    total = (
+        await db.execute(select(func.count()).select_from(stmt.subquery()))
+    ).scalar_one()
+    rows = (
+        await db.execute(
+            stmt.order_by(PortfolioHolding.updated_at.desc(), PortfolioHolding.id.desc())
+            .limit(limit)
+            .offset(offset)
+        )
+    ).all()
+    return [
+        _as_holding_read(h, startup, profile)
+        for h, startup, profile in rows
+    ], int(total)
+
+
+async def get_holding(db: AsyncSession, user: User, holding_id: uuid.UUID) -> HoldingRead:
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=False)
+    holding = await _holding_or_404(db, holding_id, org.id)
+    startup, profile = await _startup_snapshot(db, holding.startup_org_id)
+    return _as_holding_read(holding, startup, profile)
+
+
+async def create_holding(
+    db: AsyncSession, user: User, payload: HoldingCreate
+) -> HoldingRead:
+    await _enforce_portfolio_write_limit(user)
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=True)
+
+    if payload.startup_org_id == org.id:
+        raise validation_error(
+            "An investor cannot hold itself.",
+            details=[{"loc": ["body", "startup_org_id"], "msg": "Invalid startup.", "type": "value_error"}],
+        )
+    startup = await organization_service.startup_org_or_404(db, payload.startup_org_id)
+    if payload.commitment_id is not None:
+        commitment = (
+            await db.execute(
+                select(Commitment).where(
+                    Commitment.id == payload.commitment_id,
+                    Commitment.investor_org_id == org.id,
+                )
+            )
+        ).scalar_one_or_none()
+        if commitment is None:
+            raise validation_error(
+                "commitment_id must be a commitment of this firm.",
+                details=[{"loc": ["body", "commitment_id"], "msg": "Invalid commitment.", "type": "value_error"}],
+            )
+
+    holding = PortfolioHolding(
+        investor_org_id=org.id,
+        startup_org_id=startup.id,
+        commitment_id=payload.commitment_id,
+        instrument=payload.instrument,
+        invested_amount=payload.invested_amount,
+        currency=payload.currency,
+        ownership_pct=payload.ownership_pct,
+        invested_on=payload.invested_on,
+        status="active",
+    )
+    db.add(holding)
+    await db.flush()
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.holding_created,
+        org_id=org.id,
+        actor_id=user.id,
+        entity_type="portfolio_holding",
+        entity_id=holding.id,
+        summary=(
+            f"{user.display_name or 'An investor'} recorded a holding in "
+            f"{startup.name} ({holding.invested_amount} {holding.currency})."
+        ),
+    )
+    await db.commit()
+    await db.refresh(holding)
+    _, profile = await _startup_snapshot(db, holding.startup_org_id)
+    return _as_holding_read(holding, startup, profile)
+
+
+async def update_holding(
+    db: AsyncSession, user: User, holding_id: uuid.UUID, payload: HoldingUpdate
+) -> HoldingRead:
+    await _enforce_portfolio_write_limit(user)
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=True)
+    holding = await _holding_or_404(db, holding_id, org.id)
+
+    if payload.instrument is not None:
+        holding.instrument = payload.instrument
+    if payload.invested_amount is not None:
+        holding.invested_amount = payload.invested_amount
+    if payload.currency is not None:
+        holding.currency = payload.currency
+    if payload.ownership_pct is not None:
+        holding.ownership_pct = payload.ownership_pct
+    if payload.invested_on is not None:
+        holding.invested_on = payload.invested_on
+
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.holding_updated,
+        org_id=org.id,
+        actor_id=user.id,
+        entity_type="portfolio_holding",
+        entity_id=holding.id,
+        summary=f"{user.display_name or 'An investor'} updated the holding.",
+    )
+    await db.commit()
+    await db.refresh(holding)
+    startup, profile = await _startup_snapshot(db, holding.startup_org_id)
+    return _as_holding_read(holding, startup, profile)
+
+
+async def transition_holding(
+    db: AsyncSession,
+    user: User,
+    holding_id: uuid.UUID,
+    target: str,
+    exited_on: date | None = None,
+    exit_value: Decimal | None = None,
+) -> HoldingRead:
+    await _enforce_portfolio_write_limit(user)
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=True)
+    holding = await _holding_or_404(db, holding_id, org.id)
+
+    _check_holding_transition(holding.status, target)
+    if target in ("exited", "partially_exited", "written_off"):
+        holding.exited_on = exited_on
+        holding.exit_value = exit_value
+
+    previous = holding.status
+    holding.status = target
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.holding_status_changed,
+        org_id=org.id,
+        actor_id=user.id,
+        entity_type="portfolio_holding",
+        entity_id=holding.id,
+        summary=(
+            f"{user.display_name or 'An investor'} moved the holding "
+            f"from {previous} to {target}."
+        ),
+    )
+    await db.commit()
+    await db.refresh(holding)
+    startup, profile = await _startup_snapshot(db, holding.startup_org_id)
+    return _as_holding_read(holding, startup, profile)
+
+
+__all__ = [
+    "create_commitment",
+    "create_holding",
+    "get_commitment",
+    "get_holding",
+    "list_commitments",
+    "list_holdings",
+    "transition_commitment",
+    "transition_holding",
+    "update_commitment",
+    "update_holding",
+]
diff --git a/backend/app/services/diligence_service.py b/backend/app/services/diligence_service.py
new file mode 100644
index 0000000..8d68c01
--- /dev/null
+++ b/backend/app/services/diligence_service.py
@@ -0,0 +1,533 @@
+"""Step 9k service: investor diligence checklists and items.
+
+Authorization mirrors the 9e/9i/9j/9f precedent:
+
+- **Investor side only** (``/investors/diligence``): the caller's
+  active ``investor_firm`` org is resolved server-side
+  (``_investor_org_or_404``). Reads: any active member. Writes:
+  owner/admin/member (viewer 403). Rows are org-scoped — another
+  firm's checklist or item is a **404**, never 403 (no existence
+  oracle).
+
+There is exactly one checklist per (investor firm, startup)
+(partial unique index). Creating a checklist when one already exists
+returns the existing one (idempotent — the frontend "open workspace"
+action). Items belong to a checklist; deleting an item is a soft
+delete (``deleted_at``).
+
+Diligence data is **investor-private**: nothing here is exposed
+through any startup-side route.
+
+Every mutation writes an ``activity_events`` row in the SAME
+transaction (the 5i/9e pattern).
+"""
+
+import uuid
+
+from sqlalchemy import func, select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.core.config import get_settings
+from app.core.exceptions import not_found, rate_limited, validation_error
+from app.models.activity import ActivityEventType
+from app.models.diligence import (
+    DiligenceItemSeverity,
+    DiligenceItemStatus,
+    DiligenceItemType,
+    DiligenceOverallStatus,
+    InvestorDiligenceChecklist,
+    InvestorDiligenceItem,
+)
+from app.models.funding_round import FundingRound
+from app.models.investor_deal import InvestorDeal
+from app.models.organization import (
+    MemberStatus,
+    Organization,
+    OrganizationMember,
+    OrgRole,
+    OrgType,
+)
+from app.models.user import User
+from app.schemas.diligence import (
+    DiligenceChecklistRead,
+    DiligenceItemRead,
+)
+from app.services import activity_service, organization_service, rate_limiter
+
+WRITE_ROLES = {OrgRole.owner, OrgRole.admin, OrgRole.member}
+
+
+async def _enforce_diligence_write_limit(user: User) -> None:
+    settings = get_settings()
+    if not await rate_limiter.rate_limiter.check(
+        f"diligence_write:user:{user.id}",
+        settings.DILIGENCE_WRITE_LIMIT,
+        settings.DILIGENCE_WRITE_WINDOW_SECONDS,
+    ):
+        raise rate_limited("Too many diligence changes. Please slow down.")
+
+
+async def _investor_org_or_404(db: AsyncSession, user: User) -> Organization:
+    """The caller's active ``investor_firm`` organization, or 404."""
+    result = await db.execute(
+        select(Organization)
+        .join(OrganizationMember, OrganizationMember.org_id == Organization.id)
+        .where(
+            OrganizationMember.user_id == user.id,
+            OrganizationMember.deleted_at.is_(None),
+            OrganizationMember.status == MemberStatus.active,
+            Organization.type == OrgType.investor_firm,
+            Organization.status == "active",
+            Organization.deleted_at.is_(None),
+        )
+        .order_by(OrganizationMember.joined_at)
+    )
+    org = result.scalars().first()
+    if org is None:
+        raise not_found(
+            "No investor organization found for this account.",
+            code="INVESTOR_ORG_NOT_FOUND",
+        )
+    return org
+
+
+async def _require_member(
+    db: AsyncSession, org: Organization, user: User, *, write: bool
+) -> None:
+    if write:
+        await organization_service.require_membership(
+            db, org.id, user, roles=WRITE_ROLES
+        )
+    else:
+        await organization_service.require_membership(db, org.id, user)
+
+
+async def _validate_round_ref(
+    db: AsyncSession, startup_org_id: uuid.UUID, round_id: uuid.UUID | None
+) -> None:
+    """A round_id, if given, must be a live round OF THIS STARTUP."""
+    if round_id is None:
+        return
+    result = await db.execute(
+        select(FundingRound.id).where(
+            FundingRound.id == round_id,
+            FundingRound.org_id == startup_org_id,
+            FundingRound.deleted_at.is_(None),
+        )
+    )
+    if result.first() is None:
+        raise validation_error(
+            "round_id must be a live funding round of this startup.",
+            details=[
+                {"loc": ["body", "round_id"], "msg": "Invalid round.", "type": "value_error"}
+            ],
+        )
+
+
+async def _validate_deal_ref(
+    db: AsyncSession, investor_org_id: uuid.UUID, deal_id: uuid.UUID | None
+) -> None:
+    """A deal_id, if given, must be a live deal of THIS firm."""
+    if deal_id is None:
+        return
+    result = await db.execute(
+        select(InvestorDeal.id).where(
+            InvestorDeal.id == deal_id,
+            InvestorDeal.investor_org_id == investor_org_id,
+            InvestorDeal.deleted_at.is_(None),
+        )
+    )
+    if result.first() is None:
+        raise validation_error(
+            "deal_id must be a live deal of this firm.",
+            details=[
+                {"loc": ["body", "deal_id"], "msg": "Invalid deal.", "type": "value_error"}
+            ],
+        )
+
+
+def _as_checklist_read(
+    checklist: InvestorDiligenceChecklist,
+) -> DiligenceChecklistRead:
+    return DiligenceChecklistRead(
+        id=checklist.id,
+        investor_org_id=checklist.investor_org_id,
+        startup_org_id=checklist.startup_org_id,
+        round_id=checklist.round_id,
+        deal_id=checklist.deal_id,
+        overall_status=checklist.overall_status.value,
+        notes=checklist.notes,
+        scorecard=checklist.scorecard,
+        owner_id=checklist.owner_id,
+        created_by=checklist.created_by,
+        created_at=checklist.created_at,
+        updated_at=checklist.updated_at,
+    )
+
+
+def _as_item_read(item: InvestorDiligenceItem) -> DiligenceItemRead:
+    return DiligenceItemRead(
+        id=item.id,
+        checklist_id=item.checklist_id,
+        investor_org_id=item.investor_org_id,
+        startup_org_id=item.startup_org_id,
+        item_type=item.item_type.value,
+        title=item.title,
+        severity=item.severity.value if item.severity else None,
+        status=item.status.value,
+        due_on=item.due_on,
+        response=item.response,
+        owner_id=item.owner_id,
+        created_by=item.created_by,
+        created_at=item.created_at,
+        updated_at=item.updated_at,
+    )
+
+
+async def _checklist_or_404(
+    db: AsyncSession, investor_org_id: uuid.UUID, checklist_id: uuid.UUID
+) -> InvestorDiligenceChecklist:
+    result = await db.execute(
+        select(InvestorDiligenceChecklist).where(
+            InvestorDiligenceChecklist.id == checklist_id,
+            InvestorDiligenceChecklist.investor_org_id == investor_org_id,
+            InvestorDiligenceChecklist.deleted_at.is_(None),
+        )
+    )
+    checklist = result.scalar_one_or_none()
+    if checklist is None:
+        raise not_found("Diligence checklist not found.")
+    return checklist
+
+
+async def _item_or_404(
+    db: AsyncSession,
+    investor_org_id: uuid.UUID,
+    checklist_id: uuid.UUID,
+    item_id: uuid.UUID,
+) -> InvestorDiligenceItem:
+    result = await db.execute(
+        select(InvestorDiligenceItem).where(
+            InvestorDiligenceItem.id == item_id,
+            InvestorDiligenceItem.checklist_id == checklist_id,
+            InvestorDiligenceItem.investor_org_id == investor_org_id,
+            InvestorDiligenceItem.deleted_at.is_(None),
+        )
+    )
+    item = result.scalar_one_or_none()
+    if item is None:
+        raise not_found("Diligence item not found.")
+    return item
+
+
+# ---------------------------------------------------------------------------
+# Checklists
+# ---------------------------------------------------------------------------
+async def list_checklists(
+    db: AsyncSession,
+    user: User,
+    *,
+    limit: int = 20,
+    offset: int = 0,
+) -> tuple[list[DiligenceChecklistRead], int]:
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=False)
+    total = (
+        await db.execute(
+            select(func.count())
+            .select_from(InvestorDiligenceChecklist)
+            .where(
+                InvestorDiligenceChecklist.investor_org_id == org.id,
+                InvestorDiligenceChecklist.deleted_at.is_(None),
+            )
+        )
+    ).scalar_one()
+    result = await db.execute(
+        select(InvestorDiligenceChecklist)
+        .where(
+            InvestorDiligenceChecklist.investor_org_id == org.id,
+            InvestorDiligenceChecklist.deleted_at.is_(None),
+        )
+        .order_by(InvestorDiligenceChecklist.created_at.desc())
+        .limit(limit)
+        .offset(offset)
+    )
+    return [_as_checklist_read(c) for c in result.scalars().all()], total
+
+
+async def get_checklist(
+    db: AsyncSession, user: User, checklist_id: uuid.UUID
+) -> DiligenceChecklistRead:
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=False)
+    checklist = await _checklist_or_404(db, org.id, checklist_id)
+    return _as_checklist_read(checklist)
+
+
+async def create_checklist(
+    db: AsyncSession,
+    user: User,
+    *,
+    startup_org_id: uuid.UUID,
+    round_id: uuid.UUID | None = None,
+    deal_id: uuid.UUID | None = None,
+    notes: str | None = None,
+) -> DiligenceChecklistRead:
+    await _enforce_diligence_write_limit(user)
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=True)
+    await _validate_round_ref(db, startup_org_id, round_id)
+    await _validate_deal_ref(db, org.id, deal_id)
+    startup = await organization_service.startup_org_or_404(db, startup_org_id)
+    if startup.id == org.id:
+        raise validation_error("An investor firm cannot diligence itself.")
+
+    # Idempotent: return the existing checklist if one is open.
+    existing = (
+        await db.execute(
+            select(InvestorDiligenceChecklist).where(
+                InvestorDiligenceChecklist.investor_org_id == org.id,
+                InvestorDiligenceChecklist.startup_org_id == startup.id,
+                InvestorDiligenceChecklist.deleted_at.is_(None),
+            )
+        )
+    ).scalar_one_or_none()
+    if existing is not None:
+        return _as_checklist_read(existing)
+
+    checklist = InvestorDiligenceChecklist(
+        investor_org_id=org.id,
+        startup_org_id=startup.id,
+        round_id=round_id,
+        deal_id=deal_id,
+        overall_status=DiligenceOverallStatus.not_started,
+        notes=notes,
+        owner_id=user.id,
+        created_by=user.id,
+    )
+    db.add(checklist)
+    await db.flush()
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.diligence_checklist_created,
+        summary=f"Diligence checklist opened for {startup.name}",
+        org_id=org.id,
+        actor_id=user.id,
+        entity_type="diligence_checklist",
+        entity_id=checklist.id,
+        data={"startup_org_id": str(startup.id)},
+    )
+    await db.commit()
+    await db.refresh(checklist)
+    return _as_checklist_read(checklist)
+
+
+async def update_checklist(
+    db: AsyncSession,
+    user: User,
+    checklist_id: uuid.UUID,
+    *,
+    overall_status: str | None = None,
+    notes: str | None = None,
+    scorecard: dict | None = None,
+) -> DiligenceChecklistRead:
+    await _enforce_diligence_write_limit(user)
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=True)
+    checklist = await _checklist_or_404(db, org.id, checklist_id)
+
+    changed = False
+    if overall_status is not None:
+        checklist.overall_status = DiligenceOverallStatus(overall_status)
+        changed = True
+    if notes is not None:
+        checklist.notes = notes
+        changed = True
+    if scorecard is not None:
+        checklist.scorecard = scorecard
+        changed = True
+    if changed:
+        activity_service.record(
+            db,
+            event_type=ActivityEventType.diligence_checklist_updated,
+            summary="Diligence checklist updated",
+            org_id=org.id,
+            actor_id=user.id,
+            entity_type="diligence_checklist",
+            entity_id=checklist.id,
+            data={
+                "overall_status": checklist.overall_status.value,
+                "fields": sorted(
+                    [f for f, v in (("overall_status", overall_status), ("notes", notes), ("scorecard", scorecard)) if v is not None]
+                ),
+            },
+        )
+        await db.commit()
+        await db.refresh(checklist)
+    return _as_checklist_read(checklist)
+
+
+# ---------------------------------------------------------------------------
+# Items
+# ---------------------------------------------------------------------------
+async def list_items(
+    db: AsyncSession,
+    user: User,
+    checklist_id: uuid.UUID,
+    *,
+    item_type: DiligenceItemType | None = None,
+    limit: int = 20,
+    offset: int = 0,
+) -> tuple[list[DiligenceItemRead], int]:
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=False)
+    await _checklist_or_404(db, org.id, checklist_id)
+    filters = [
+        InvestorDiligenceItem.checklist_id == checklist_id,
+        InvestorDiligenceItem.investor_org_id == org.id,
+        InvestorDiligenceItem.deleted_at.is_(None),
+    ]
+    if item_type is not None:
+        filters.append(InvestorDiligenceItem.item_type == item_type)
+    total = (
+        await db.execute(
+            select(func.count())
+            .select_from(InvestorDiligenceItem)
+            .where(*filters)
+        )
+    ).scalar_one()
+    result = await db.execute(
+        select(InvestorDiligenceItem)
+        .where(*filters)
+        .order_by(InvestorDiligenceItem.created_at.desc())
+        .limit(limit)
+        .offset(offset)
+    )
+    return [_as_item_read(i) for i in result.scalars().all()], total
+
+
+async def create_item(
+    db: AsyncSession,
+    user: User,
+    checklist_id: uuid.UUID,
+    *,
+    item_type: str,
+    title: str,
+    severity: str | None = None,
+    status: str | None = None,
+    due_on=None,
+    response: str | None = None,
+) -> DiligenceItemRead:
+    await _enforce_diligence_write_limit(user)
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=True)
+    checklist = await _checklist_or_404(db, org.id, checklist_id)
+
+    item = InvestorDiligenceItem(
+        checklist_id=checklist.id,
+        investor_org_id=org.id,
+        startup_org_id=checklist.startup_org_id,
+        item_type=DiligenceItemType(item_type),
+        title=title,
+        severity=DiligenceItemSeverity(severity) if severity else None,
+        status=DiligenceItemStatus(status or DiligenceItemStatus.not_started.value),
+        due_on=due_on,
+        response=response,
+        owner_id=user.id,
+        created_by=user.id,
+    )
+    db.add(item)
+    await db.flush()
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.diligence_item_created,
+        summary=f"Diligence item added: {item.title}",
+        org_id=org.id,
+        actor_id=user.id,
+        entity_type="diligence_item",
+        entity_id=item.id,
+        data={"checklist_id": str(checklist.id), "item_type": item.item_type.value},
+    )
+    await db.commit()
+    await db.refresh(item)
+    return _as_item_read(item)
+
+
+async def update_item(
+    db: AsyncSession,
+    user: User,
+    checklist_id: uuid.UUID,
+    item_id: uuid.UUID,
+    *,
+    title: str | None = None,
+    severity: str | None = None,
+    status: str | None = None,
+    due_on=None,
+    response: str | None = None,
+) -> DiligenceItemRead:
+    await _enforce_diligence_write_limit(user)
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=True)
+    item = await _item_or_404(db, org.id, checklist_id, item_id)
+
+    changed = False
+    if title is not None:
+        item.title = title
+        changed = True
+    if severity is not None:
+        item.severity = DiligenceItemSeverity(severity) if severity else None
+        changed = True
+    if status is not None:
+        item.status = DiligenceItemStatus(status)
+        changed = True
+    if due_on is not None:
+        item.due_on = due_on
+        changed = True
+    if response is not None:
+        item.response = response
+        changed = True
+    if changed:
+        activity_service.record(
+            db,
+            event_type=ActivityEventType.diligence_item_updated,
+            summary=f"Diligence item updated: {item.title}",
+            org_id=org.id,
+            actor_id=user.id,
+            entity_type="diligence_item",
+            entity_id=item.id,
+        )
+        await db.commit()
+        await db.refresh(item)
+    return _as_item_read(item)
+
+
+async def delete_item(
+    db: AsyncSession, user: User, checklist_id: uuid.UUID, item_id: uuid.UUID
+) -> None:
+    await _enforce_diligence_write_limit(user)
+    org = await _investor_org_or_404(db, user)
+    await _require_member(db, org, user, write=True)
+    item = await _item_or_404(db, org.id, checklist_id, item_id)
+    item.deleted_at = func.now()
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.diligence_item_deleted,
+        summary=f"Diligence item deleted: {item.title}",
+        org_id=org.id,
+        actor_id=user.id,
+        entity_type="diligence_item",
+        entity_id=item.id,
+    )
+    await db.commit()
+
+
+__all__ = [
+    "create_checklist",
+    "create_item",
+    "delete_item",
+    "get_checklist",
+    "list_checklists",
+    "list_items",
+    "update_checklist",
+    "update_item",
+]
