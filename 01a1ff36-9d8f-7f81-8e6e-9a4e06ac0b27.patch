diff --git a/backend/app/models/funding_round.py b/backend/app/models/funding_round.py
new file mode 100644
index 0000000..0576841
--- /dev/null
+++ b/backend/app/models/funding_round.py
@@ -0,0 +1,213 @@
+"""Funding round model (Step 9a, schema.sql section 6 ``funding_rounds``).
+
+Mirrors schema.sql, with the project's portable-type policy (same as
+migrations 0003-0023):
+
+- Native PG enums (``funding_round_type``, ``round_status``,
+  ``instrument_type``) -> VARCHAR + named CHECK via
+  ``Enum(native_enum=False)`` / ``String`` + CHECK, never native enums.
+- ``currency char(3)`` -> ``String(3)`` + ``length(currency) = 3`` CHECK:
+  ``char`` pads with spaces and does not exist on SQLite; the value is a
+  3-letter ISO code either way (``talent.py``/``earning.py`` already do this).
+- ``round_amounts_non_negative`` and ``funding_rounds_org_idx`` kept verbatim.
+
+Approved deviations from schema.sql (9a plan, user-approved):
+
+- ``min_raise`` / ``min_ticket`` added (nullable ``NUMERIC(14,2)``): the
+  "Set up a fundraising round" modal collects Minimum raise and Minimum
+  ticket, and schema.sql has no columns for either (plan D4).
+- ``pre_money_valuation >= 0`` CHECK added (plan D8): schema.sql has no
+  CHECK there; a negative valuation is nonsense.
+- ``committed_amount`` is server-only in 9a (plan D2): it starts at 0 and
+  only 9i/9j (offers/commitments) will ever write it. Progress
+  (remaining / progress_pct) is derived in the service, never stored.
+
+Money: ``NUMERIC(14,2)`` + ISO-4217 ``currency`` defaulting to INR
+(AGENTS.md section 6). Amounts are serialized as decimal strings, never
+floats (the 5e ``MetricRead`` pattern).
+"""
+
+import enum
+import uuid
+from datetime import date, datetime
+from decimal import Decimal
+
+from sqlalchemy import (
+    CheckConstraint,
+    Date,
+    DateTime,
+    ForeignKey,
+    Index,
+    Numeric,
+    String,
+    func,
+    text,
+)
+from sqlalchemy.dialects.postgresql import UUID as PG_UUID
+from sqlalchemy.orm import Mapped, mapped_column
+
+from app.db.base import Base
+
+
+class FundingRoundType(enum.StrEnum):
+    """schema.sql ``funding_round_type``."""
+
+    pre_seed = "pre_seed"
+    seed = "seed"
+    series_a = "series_a"
+    series_b = "series_b"
+    bridge = "bridge"
+    safe = "safe"
+    other = "other"
+
+
+class RoundStatus(enum.StrEnum):
+    """schema.sql ``round_status``."""
+
+    draft = "draft"
+    open = "open"
+    paused = "paused"
+    closed = "closed"
+    cancelled = "cancelled"
+
+
+class InstrumentType(enum.StrEnum):
+    """schema.sql ``instrument_type``."""
+
+    equity = "equity"
+    safe = "safe"
+    convertible_note = "convertible_note"
+    ccd = "ccd"
+    ccps = "ccps"
+    debt = "debt"
+    other = "other"
+
+
+# Status lifecycle (plan D1/D14): the only transitions the service allows.
+# ``cancelled`` is terminal; ``closed`` may reopen to ``open`` (the
+# round-detail page has a Reopen button).
+ROUND_TRANSITIONS: dict[RoundStatus, frozenset[RoundStatus]] = {
+    RoundStatus.draft: frozenset({RoundStatus.open, RoundStatus.cancelled}),
+    RoundStatus.open: frozenset(
+        {RoundStatus.paused, RoundStatus.closed, RoundStatus.cancelled}
+    ),
+    RoundStatus.paused: frozenset(
+        {RoundStatus.open, RoundStatus.closed, RoundStatus.cancelled}
+    ),
+    RoundStatus.closed: frozenset({RoundStatus.open}),
+    RoundStatus.cancelled: frozenset(),
+}
+
+_ROUND_TYPE_SQL = (
+    "round_type IN ('pre_seed','seed','series_a','series_b','bridge','safe','other')"
+)
+_ROUND_STATUS_SQL = "status IN ('draft','open','paused','closed','cancelled')"
+_INSTRUMENT_SQL = (
+    "instrument IS NULL OR instrument IN "
+    "('equity','safe','convertible_note','ccd','ccps','debt','other')"
+)
+
+
+class FundingRound(Base):
+    """One fundraising round belonging to a startup organization."""
+
+    __tablename__ = "funding_rounds"
+
+    id: Mapped[uuid.UUID] = mapped_column(
+        PG_UUID(as_uuid=True), primary_key=True, default=uuid.uuid4
+    )
+    org_id: Mapped[uuid.UUID] = mapped_column(
+        PG_UUID(as_uuid=True),
+        ForeignKey("organizations.id", ondelete="CASCADE"),
+        nullable=False,
+    )
+    name: Mapped[str] = mapped_column(String(200), nullable=False)
+    round_type: Mapped[FundingRoundType] = mapped_column(
+        String(16),
+        nullable=False,
+    )
+    target_amount: Mapped[Decimal | None] = mapped_column(
+        Numeric(14, 2), nullable=True
+    )
+    # Server-only in 9a (plan D2): starts at 0, written only by 9i/9j.
+    committed_amount: Mapped[Decimal] = mapped_column(
+        Numeric(14, 2), nullable=False, default=Decimal("0"), server_default="0"
+    )
+    currency: Mapped[str] = mapped_column(
+        String(3), nullable=False, default="INR", server_default="INR"
+    )
+    pre_money_valuation: Mapped[Decimal | None] = mapped_column(
+        Numeric(14, 2), nullable=True
+    )
+    instrument: Mapped[InstrumentType | None] = mapped_column(
+        String(16), nullable=True
+    )
+    status: Mapped[RoundStatus] = mapped_column(
+        String(16),
+        nullable=False,
+        default=RoundStatus.draft,
+        server_default="draft",
+    )
+    opens_on: Mapped[date | None] = mapped_column(Date, nullable=True)
+    closes_on: Mapped[date | None] = mapped_column(Date, nullable=True)
+    # Plan D4: the modal's Minimum raise / Minimum ticket.
+    min_raise: Mapped[Decimal | None] = mapped_column(Numeric(14, 2), nullable=True)
+    min_ticket: Mapped[Decimal | None] = mapped_column(Numeric(14, 2), nullable=True)
+    created_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True), nullable=False, server_default=func.now()
+    )
+    updated_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True),
+        nullable=False,
+        server_default=func.now(),
+        onupdate=func.now(),
+    )
+    deleted_at: Mapped[datetime | None] = mapped_column(
+        DateTime(timezone=True), nullable=True
+    )
+
+    __table_args__ = (
+        CheckConstraint(_ROUND_TYPE_SQL, name="funding_round_type_valid"),
+        CheckConstraint(_ROUND_STATUS_SQL, name="round_status_valid"),
+        CheckConstraint(_INSTRUMENT_SQL, name="funding_round_instrument_valid"),
+        # schema.sql verbatim.
+        CheckConstraint(
+            "(target_amount IS NULL OR target_amount > 0) AND committed_amount >= 0",
+            name="round_amounts_non_negative",
+        ),
+        # Plan D8: a negative valuation is nonsense.
+        CheckConstraint(
+            "pre_money_valuation IS NULL OR pre_money_valuation >= 0",
+            name="funding_rounds_valuation_check",
+        ),
+        CheckConstraint("length(currency) = 3", name="funding_rounds_currency_check"),
+        CheckConstraint(
+            "min_raise IS NULL OR min_raise > 0",
+            name="funding_rounds_min_raise_check",
+        ),
+        CheckConstraint(
+            "min_ticket IS NULL OR min_ticket > 0",
+            name="funding_rounds_min_ticket_check",
+        ),
+        CheckConstraint(
+            "length(trim(name)) BETWEEN 1 AND 200",
+            name="funding_rounds_name_check",
+        ),
+        # schema.sql verbatim (partial index on live rows).
+        Index(
+            "funding_rounds_org_idx",
+            "org_id",
+            "status",
+            postgresql_where=text("deleted_at IS NULL"),
+            sqlite_where=text("deleted_at IS NULL"),
+        ),
+    )
+
+
+__all__ = [
+    "FundingRound",
+    "FundingRoundType",
+    "InstrumentType",
+    "ROUND_TRANSITIONS",
+    "RoundStatus",
+]
diff --git a/backend/app/routers/funding_round.py b/backend/app/routers/funding_round.py
new file mode 100644
index 0000000..326adca
--- /dev/null
+++ b/backend/app/routers/funding_round.py
@@ -0,0 +1,170 @@
+"""Funding round router (Step 9a).
+
+Thin routes only (AGENTS.md section 3): the actor comes from
+``get_current_user``, ``org_id``/``round_id`` are ``uuid.UUID`` (a
+malformed id is a 422 before any service code runs), and every guard,
+org-scoped lookup, state machine and rate limit lives in
+``funding_round_service``.
+
+Routes:
+
+- ``POST /organizations/{org_id}/funding-rounds`` — create (201).
+- ``GET /organizations/{org_id}/funding-rounds`` — paginated list.
+- ``GET /organizations/{org_id}/funding-rounds/summary`` — header roll-up.
+- ``GET /organizations/{org_id}/funding-rounds/{round_id}`` — detail.
+- ``PATCH /organizations/{org_id}/funding-rounds/{round_id}`` — edit.
+- ``POST /organizations/{org_id}/funding-rounds/{round_id}/status`` — transition.
+- ``DELETE /organizations/{org_id}/funding-rounds/{round_id}`` — soft delete.
+
+``committed_amount`` and ``status`` are never accepted from the client:
+they are absent from the Create/Update schemas (``extra="forbid"`` ->
+422) and ``status`` only changes via the transition endpoint.
+"""
+
+import uuid
+from typing import Annotated
+
+from fastapi import APIRouter, Depends, Query, status
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.core.dependencies import get_current_user
+from app.db.session import get_db
+from app.models.funding_round import RoundStatus
+from app.models.user import User
+from app.schemas.funding_round import (
+    FundingRoundCreate,
+    FundingRoundPage,
+    FundingRoundRead,
+    FundingRoundSummary,
+    FundingRoundUpdate,
+    StatusTransition,
+)
+from app.services import funding_round_service
+
+router = APIRouter(prefix="/organizations", tags=["funding-rounds"])
+
+
+@router.post(
+    "/{org_id}/funding-rounds",
+    response_model=FundingRoundRead,
+    status_code=status.HTTP_201_CREATED,
+    summary="Create a funding round",
+)
+async def create_funding_round(
+    org_id: uuid.UUID,
+    payload: FundingRoundCreate,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> FundingRoundRead:
+    """Owner/admin/member of the startup; viewer gets 403.
+
+    ``committed_amount`` starts at 0 (server-only in 9a).
+    """
+    return await funding_round_service.create(db, user, org_id, payload)
+
+
+@router.get(
+    "/{org_id}/funding-rounds",
+    response_model=FundingRoundPage,
+    summary="List a startup's funding rounds",
+)
+async def list_funding_rounds(
+    org_id: uuid.UUID,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+    status_filter: Annotated[
+        RoundStatus | None, Query(alias="status", description="Filter by round status")
+    ] = None,
+    sort: Annotated[str, Query(description="created_at | closes_on | name")] = "created_at",
+    limit: Annotated[int, Query(ge=1, le=100)] = 20,
+    offset: Annotated[int, Query(ge=0)] = 0,
+) -> FundingRoundPage:
+    """Any active member may read (viewer included).
+
+    Sort keys are whitelisted by the service; an unknown key is a 422
+    (the ``Literal``-style guard happens in the service dict lookup).
+    """
+    items, total = await funding_round_service.list_rounds(
+        db, user, org_id, status=status_filter, sort=sort, limit=limit, offset=offset
+    )
+    return FundingRoundPage(
+        items=list(items), total=total, limit=limit, offset=offset, has_more=offset + len(items) < total
+    )
+
+
+@router.get(
+    "/{org_id}/funding-rounds/summary",
+    response_model=FundingRoundSummary,
+    summary="Startup rounds summary",
+)
+async def funding_rounds_summary(
+    org_id: uuid.UUID,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> FundingRoundSummary:
+    """Total target / committed / open-round counts in one aggregate query."""
+    return await funding_round_service.summary(db, user, org_id)
+
+
+@router.get(
+    "/{org_id}/funding-rounds/{round_id}",
+    response_model=FundingRoundRead,
+    summary="Get a funding round",
+)
+async def get_funding_round(
+    org_id: uuid.UUID,
+    round_id: uuid.UUID,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> FundingRoundRead:
+    """A foreign or deleted round is a 404 (no existence oracle)."""
+    return await funding_round_service.get_round(db, user, org_id, round_id)
+
+
+@router.patch(
+    "/{org_id}/funding-rounds/{round_id}",
+    response_model=FundingRoundRead,
+    summary="Edit a funding round",
+)
+async def update_funding_round(
+    org_id: uuid.UUID,
+    round_id: uuid.UUID,
+    payload: FundingRoundUpdate,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> FundingRoundRead:
+    """Owner/admin/member; ``status``/``committed_amount`` are not editable."""
+    return await funding_round_service.update_round(db, user, org_id, round_id, payload)
+
+
+@router.post(
+    "/{org_id}/funding-rounds/{round_id}/status",
+    response_model=FundingRoundRead,
+    summary="Change a round's status",
+)
+async def change_funding_round_status(
+    org_id: uuid.UUID,
+    round_id: uuid.UUID,
+    payload: StatusTransition,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> FundingRoundRead:
+    """Only through the defined lifecycle; an invalid move is a 409."""
+    return await funding_round_service.transition_status(
+        db, user, org_id, round_id, payload.status
+    )
+
+
+@router.delete(
+    "/{org_id}/funding-rounds/{round_id}",
+    status_code=status.HTTP_204_NO_CONTENT,
+    summary="Soft-delete a funding round",
+)
+async def delete_funding_round(
+    org_id: uuid.UUID,
+    round_id: uuid.UUID,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> None:
+    """Sets ``deleted_at``; a repeat delete is a 404."""
+    await funding_round_service.delete_round(db, user, org_id, round_id)
diff --git a/backend/app/schemas/funding_round.py b/backend/app/schemas/funding_round.py
new file mode 100644
index 0000000..0dfa89b
--- /dev/null
+++ b/backend/app/schemas/funding_round.py
@@ -0,0 +1,211 @@
+"""Funding round schemas (Step 9a).
+
+Strict, server-controlled shapes (AGENTS.md section 3):
+
+- ``Create`` and ``Update`` are ``extra="forbid"``: sending a field the
+  caller may not set is a 422, never a silent ignore (mass-assignment
+  guard). In particular ``committed_amount``, ``status``, ``id``,
+  ``org_id`` and the timestamps are absent from both input shapes —
+  ``committed_amount`` is server-only (starts at 0, only 9i/9j write it)
+  and ``status`` changes only through the transition endpoint (plan D1).
+- Money is ``Decimal`` (``NUMERIC(14,2)`` in the table) and serializes as
+  a decimal string by pydantic v2's ``Decimal`` encoder, never a float
+  (the 5e ``MetricRead`` pattern).
+- ``currency`` is a 3-letter ISO-4217 code, uppercased on input.
+- ``Read`` computes ``remaining_amount`` / ``progress_pct`` in the
+  service (derived, never stored, never writable).
+"""
+
+import uuid
+from datetime import date, datetime
+from decimal import Decimal
+
+from pydantic import BaseModel, ConfigDict, Field, field_validator, model_validator
+
+from app.models.funding_round import FundingRoundType, InstrumentType, RoundStatus
+
+# schema.sql names "target_amount" as nullable: a round may be recorded
+# before a target is agreed, so it is optional (but > 0 when present).
+_Money = Field(default=None, max_digits=14, decimal_places=2)
+
+
+def _clean_name(value: str) -> str:
+    """Strip and reject blanks (mirrors the organizations name rule)."""
+    cleaned = value.strip()
+    if not cleaned:
+        raise ValueError("Round name is required.")
+    return cleaned
+
+
+class FundingRoundCreate(BaseModel):
+    """A new round. ``committed_amount`` starts at 0 (server-set)."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    name: str = Field(min_length=1, max_length=200)
+    round_type: FundingRoundType
+    target_amount: Decimal | None = Field(default=None, max_digits=14, decimal_places=2)
+    currency: str = Field(default="INR", max_length=3)
+    pre_money_valuation: Decimal | None = Field(default=None, max_digits=14, decimal_places=2)
+    instrument: InstrumentType | None = None
+    opens_on: date | None = None
+    closes_on: date | None = None
+    min_raise: Decimal | None = Field(default=None, max_digits=14, decimal_places=2)
+    min_ticket: Decimal | None = Field(default=None, max_digits=14, decimal_places=2)
+
+    _validate_name = field_validator("name")(_clean_name)
+
+    @field_validator("currency", mode="before")
+    @classmethod
+    def _clean_currency(cls, value: str) -> str:
+        return value.strip().upper()
+
+    @field_validator("target_amount")
+    @classmethod
+    def _target_positive(cls, value: Decimal | None) -> Decimal | None:
+        if value is not None and value <= 0:
+            raise ValueError("Target amount must be greater than 0 when set.")
+        return value
+
+    @field_validator("pre_money_valuation")
+    @classmethod
+    def _valuation_non_negative(cls, value: Decimal | None) -> Decimal | None:
+        if value is not None and value < 0:
+            raise ValueError("Pre-money valuation must not be negative.")
+        return value
+
+    @field_validator("min_raise", "min_ticket")
+    @classmethod
+    def _minimums_positive(cls, value: Decimal | None) -> Decimal | None:
+        if value is not None and value <= 0:
+            raise ValueError("Minimums must be greater than 0 when set.")
+        return value
+
+    @model_validator(mode="after")
+    def _dates_ordered(self) -> "FundingRoundCreate":
+        if self.opens_on and self.closes_on and self.closes_on < self.opens_on:
+            raise ValueError("Closing date must not be before the opening date.")
+        return self
+
+
+class FundingRoundUpdate(BaseModel):
+    """Editable fields. ``status`` and ``committed_amount`` stay out."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    name: str | None = Field(default=None, min_length=1, max_length=200)
+    round_type: FundingRoundType | None = None
+    target_amount: Decimal | None = Field(default=None, max_digits=14, decimal_places=2)
+    currency: str | None = Field(default=None, max_length=3)
+    pre_money_valuation: Decimal | None = Field(default=None, max_digits=14, decimal_places=2)
+    instrument: InstrumentType | None = None
+    opens_on: date | None = None
+    closes_on: date | None = None
+    min_raise: Decimal | None = Field(default=None, max_digits=14, decimal_places=2)
+    min_ticket: Decimal | None = Field(default=None, max_digits=14, decimal_places=2)
+
+    _validate_name = field_validator("name")(_clean_name)
+
+    @field_validator("currency", mode="before")
+    @classmethod
+    def _clean_currency(cls, value: str | None) -> str | None:
+        return value.strip().upper() if value is not None else None
+
+    @field_validator("target_amount")
+    @classmethod
+    def _target_positive(cls, value: Decimal | None) -> Decimal | None:
+        if value is not None and value <= 0:
+            raise ValueError("Target amount must be greater than 0 when set.")
+        return value
+
+    @field_validator("pre_money_valuation")
+    @classmethod
+    def _valuation_non_negative(cls, value: Decimal | None) -> Decimal | None:
+        if value is not None and value < 0:
+            raise ValueError("Pre-money valuation must not be negative.")
+        return value
+
+    @field_validator("min_raise", "min_ticket")
+    @classmethod
+    def _minimums_positive(cls, value: Decimal | None) -> Decimal | None:
+        if value is not None and value <= 0:
+            raise ValueError("Minimums must be greater than 0 when set.")
+        return value
+
+    @model_validator(mode="after")
+    def _dates_ordered(self) -> "FundingRoundUpdate":
+        # Re-check the ordered rule when both are being (re)set: the
+        # patch is exclude_unset, but re-validating the final values on
+        # the model keeps the rule honest if both fields are sent.
+        if self.opens_on and self.closes_on and self.closes_on < self.opens_on:
+            raise ValueError("Closing date must not be before the opening date.")
+        return self
+
+
+class StatusTransition(BaseModel):
+    """``POST …/status``: the only way ``status`` changes (plan D1)."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    status: RoundStatus
+
+
+class FundingRoundRead(BaseModel):
+    """A round as returned by the API. Derived fields are read-only."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    id: uuid.UUID
+    org_id: uuid.UUID
+    name: str
+    round_type: FundingRoundType
+    target_amount: Decimal | None
+    committed_amount: Decimal
+    currency: str
+    pre_money_valuation: Decimal | None
+    instrument: InstrumentType | None
+    status: RoundStatus
+    opens_on: date | None
+    closes_on: date | None
+    min_raise: Decimal | None
+    min_ticket: Decimal | None
+    remaining_amount: Decimal | None
+    progress_pct: Decimal | None
+    created_at: datetime
+    updated_at: datetime
+
+
+class FundingRoundPage(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    items: list[FundingRoundRead]
+    total: int
+    limit: int
+    offset: int
+    has_more: bool
+
+
+class FundingRoundSummary(BaseModel):
+    """Org-level roll-up for the ``/startup/rounds`` header.
+
+    One aggregate query in the service — no N+1. Money is a decimal
+    string; a total with no rounds is 0 (the list is simply empty).
+    """
+
+    model_config = ConfigDict(extra="forbid")
+
+    total_target: Decimal
+    total_committed: Decimal
+    currency: str
+    open_rounds: int
+    by_status: dict[str, int]
+
+
+__all__ = [
+    "FundingRoundCreate",
+    "FundingRoundPage",
+    "FundingRoundRead",
+    "FundingRoundSummary",
+    "FundingRoundUpdate",
+    "StatusTransition",
+]
diff --git a/backend/app/services/funding_round_service.py b/backend/app/services/funding_round_service.py
new file mode 100644
index 0000000..e5d5828
--- /dev/null
+++ b/backend/app/services/funding_round_service.py
@@ -0,0 +1,378 @@
+"""Step 9a service: funding rounds (startup).
+
+Authorization in one place per operation, following the 5b/5e milestone
+and 8a-8e precedent:
+
+- **Create / edit / status / delete**: an active member with role
+  owner/admin/member. A **viewer** is read-only everywhere in the
+  product, so they get 403 (plan D13).
+- **List / get / summary**: any active member, viewer included.
+- Everyone else: a foreign ``org_id`` is caught by
+  ``startup_org_or_404`` (404); a round id from another org is caught by
+  the org-scoped lookup (404, never 403 — no existence oracle).
+
+Money handling: ``NUMERIC(14,2)`` in the table, ``Decimal`` in the
+service, decimal strings in the response. ``committed_amount`` is
+**server-only in 9a** (starts at 0; only 9i/9j will write it).
+``remaining_amount`` / ``progress_pct`` are derived here, never stored,
+never writable.
+
+Status changes only through ``ROUND_TRANSITIONS`` (plan D1); an invalid
+transition raises 409 ``INVALID_STATE``. Every create/update/status/
+delete writes an audit row in the same transaction (plan D11).
+"""
+
+import uuid
+from collections.abc import Sequence
+from datetime import UTC, datetime
+from decimal import Decimal
+from typing import Any
+
+from sqlalchemy import func, select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.core.config import get_settings
+from app.core.exceptions import (
+    conflict,
+    not_found,
+    rate_limited,
+    validation_error,
+)
+from app.models.activity import ActivityEventType
+from app.models.funding_round import (
+    ROUND_TRANSITIONS,
+    FundingRound,
+    FundingRoundType,
+    InstrumentType,
+    RoundStatus,
+)
+from app.models.organization import OrgRole
+from app.models.user import User
+from app.schemas.funding_round import (
+    FundingRoundCreate,
+    FundingRoundRead,
+    FundingRoundSummary,
+    FundingRoundUpdate,
+)
+from app.services import activity_service, organization_service, rate_limiter
+
+# Org roles allowed to write a round. Viewers are read-only (5b/5e).
+WRITE_ROLES = {OrgRole.owner, OrgRole.admin, OrgRole.member}
+
+# Whitelisted sort keys for the list endpoint (router-validated values;
+# the service translates them to SQL columns). ``created_at`` is newest
+# first; ``name`` and ``closes_on`` ascend. ``FundingRound.id.desc()`` is
+# always appended as a stable tiebreak.
+_SORT_COLUMNS: dict[str, Any] = {
+    "created_at": FundingRound.created_at,
+    "closes_on": FundingRound.closes_on,
+    "name": FundingRound.name,
+}
+_SORT_DESC = {"created_at"}
+
+_HUNDRED = Decimal("100")
+
+
+async def _enforce_write_limit(user: User) -> None:
+    settings = get_settings()
+    if not await rate_limiter.rate_limiter.check(
+        f"funding_round_write:user:{user.id}",
+        settings.FUNDING_ROUND_WRITE_LIMIT,
+        settings.FUNDING_ROUND_WRITE_WINDOW_SECONDS,
+    ):
+        raise rate_limited("Too many funding round changes. Please slow down.")
+
+
+def _as_read(row: FundingRound) -> FundingRoundRead:
+    """Map a row to its API shape, computing the derived progress.
+
+    ``progress_pct`` may exceed 100 for an oversubscribed round (plan D2);
+    it is ``None`` when there is no target to divide by.
+    """
+    target = Decimal(row.target_amount) if row.target_amount is not None else None
+    committed = Decimal(row.committed_amount or 0)
+    remaining = (target - committed) if target is not None else None
+    progress = None
+    if target is not None and target > 0:
+        progress = (committed / target) * _HUNDRED
+    return FundingRoundRead(
+        id=row.id,
+        org_id=row.org_id,
+        name=row.name,
+        round_type=FundingRoundType(row.round_type),
+        target_amount=row.target_amount,
+        committed_amount=committed,
+        currency=row.currency,
+        pre_money_valuation=row.pre_money_valuation,
+        instrument=InstrumentType(row.instrument) if row.instrument else None,
+        status=RoundStatus(row.status),
+        opens_on=row.opens_on,
+        closes_on=row.closes_on,
+        min_raise=row.min_raise,
+        min_ticket=row.min_ticket,
+        remaining_amount=remaining,
+        progress_pct=progress,
+        created_at=row.created_at,
+        updated_at=row.updated_at,
+    )
+
+
+async def _get_round(db: AsyncSession, org_id: uuid.UUID, round_id: uuid.UUID) -> FundingRound:
+    """Org-scoped lookup: a foreign or deleted round is indistinguishable."""
+    result = await db.execute(
+        select(FundingRound).where(
+            FundingRound.id == round_id,
+            FundingRound.org_id == org_id,
+            FundingRound.deleted_at.is_(None),
+        )
+    )
+    row = result.scalar_one_or_none()
+    if row is None:
+        raise not_found("Funding round not found.")
+    return row
+
+
+async def create(
+    db: AsyncSession, user: User, org_id: uuid.UUID, payload: FundingRoundCreate
+) -> FundingRoundRead:
+    await _enforce_write_limit(user)
+    org = await organization_service.startup_org_or_404(db, org_id)
+    await organization_service.require_membership(
+        db, org.id, user, roles=WRITE_ROLES
+    )
+
+    row = FundingRound(
+        org_id=org.id,
+        name=payload.name,
+        round_type=payload.round_type,
+        target_amount=payload.target_amount,
+        # Server-only: 9a always starts at 0 (plan D2).
+        committed_amount=Decimal("0"),
+        currency=payload.currency,
+        pre_money_valuation=payload.pre_money_valuation,
+        instrument=payload.instrument,
+        status=RoundStatus.draft,
+        opens_on=payload.opens_on,
+        closes_on=payload.closes_on,
+        min_raise=payload.min_raise,
+        min_ticket=payload.min_ticket,
+    )
+    db.add(row)
+    await db.flush()
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.round_created,
+        org_id=org.id,
+        actor_id=user.id,
+        entity_type="funding_round",
+        entity_id=row.id,
+        link_url=f"/startup/rounds/{row.id}",
+        summary=f"{user.display_name or 'A member'} created round “{row.name}”.",
+        data={"round_type": row.round_type, "status": row.status},
+    )
+    await db.commit()
+    await db.refresh(row)
+    return _as_read(row)
+
+
+async def list_rounds(
+    db: AsyncSession,
+    user: User,
+    org_id: uuid.UUID,
+    *,
+    status: RoundStatus | None,
+    sort: str,
+    limit: int,
+    offset: int,
+) -> tuple[Sequence[FundingRoundRead], int]:
+    org = await organization_service.startup_org_or_404(db, org_id)
+    await organization_service.require_membership(db, org.id, user)
+
+    if sort not in _SORT_COLUMNS:
+        raise validation_error("Unknown sort key.")
+
+    where = [FundingRound.org_id == org.id, FundingRound.deleted_at.is_(None)]
+    if status is not None:
+        where.append(FundingRound.status == status.value)
+
+    total = (
+        await db.execute(
+            select(func.count()).select_from(FundingRound).where(*where)
+        )
+    ).scalar_one()
+
+    sort_col = _SORT_COLUMNS[sort]
+    order_by = [
+        sort_col.desc() if sort in _SORT_DESC else sort_col.asc(),
+        FundingRound.id.desc(),
+    ]
+    rows = (
+        await db.execute(
+            select(FundingRound)
+            .where(*where)
+            .order_by(*order_by)
+            .limit(limit)
+            .offset(offset)
+        )
+    ).scalars().all()
+
+    return [_as_read(row) for row in rows], total
+
+
+async def get_round(db: AsyncSession, user: User, org_id: uuid.UUID, round_id: uuid.UUID) -> FundingRoundRead:
+    org = await organization_service.startup_org_or_404(db, org_id)
+    await organization_service.require_membership(db, org.id, user)
+    return _as_read(await _get_round(db, org.id, round_id))
+
+
+async def update_round(
+    db: AsyncSession,
+    user: User,
+    org_id: uuid.UUID,
+    round_id: uuid.UUID,
+    payload: FundingRoundUpdate,
+) -> FundingRoundRead:
+    await _enforce_write_limit(user)
+    org = await organization_service.startup_org_or_404(db, org_id)
+    await organization_service.require_membership(db, org.id, user, roles=WRITE_ROLES)
+
+    row = await _get_round(db, org.id, round_id)
+    data = payload.model_dump(exclude_unset=True)
+    if "name" in data and data["name"] is not None:
+        data["name"] = data["name"].strip()
+    # ``model_dump`` returns enum members (not raw strings), so the
+    # setattr below stores valid enum values for round_type/instrument.
+    for field, value in data.items():
+        setattr(row, field, value)
+
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.round_updated,
+        org_id=org.id,
+        actor_id=user.id,
+        entity_type="funding_round",
+        entity_id=row.id,
+        link_url=f"/startup/rounds/{row.id}",
+        summary=f"{user.display_name or 'A member'} updated round “{row.name}”.",
+        data={"fields": sorted(data.keys())},
+    )
+    await db.commit()
+    await db.refresh(row)
+    return _as_read(row)
+
+
+async def transition_status(
+    db: AsyncSession, user: User, org_id: uuid.UUID, round_id: uuid.UUID, status: RoundStatus
+) -> FundingRoundRead:
+    await _enforce_write_limit(user)
+    org = await organization_service.startup_org_or_404(db, org_id)
+    await organization_service.require_membership(db, org.id, user, roles=WRITE_ROLES)
+
+    row = await _get_round(db, org.id, round_id)
+    current = RoundStatus(row.status)
+    allowed = ROUND_TRANSITIONS[current]
+    if status not in allowed:
+        raise conflict(
+            f"Cannot move a round from '{current.value}' to '{status.value}'.",
+            code="INVALID_STATE",
+        )
+    previous = row.status
+    row.status = status
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.round_status_changed,
+        org_id=org.id,
+        actor_id=user.id,
+        entity_type="funding_round",
+        entity_id=row.id,
+        link_url=f"/startup/rounds/{row.id}",
+        summary=(
+            f"{user.display_name or 'A member'} moved round “{row.name}”"
+            f" from {previous} to {status.value}."
+        ),
+        data={"from": previous, "to": status.value},
+    )
+    await db.commit()
+    await db.refresh(row)
+    return _as_read(row)
+
+
+async def delete_round(db: AsyncSession, user: User, org_id: uuid.UUID, round_id: uuid.UUID) -> None:
+    await _enforce_write_limit(user)
+    org = await organization_service.startup_org_or_404(db, org_id)
+    await organization_service.require_membership(db, org.id, user, roles=WRITE_ROLES)
+
+    row = await _get_round(db, org.id, round_id)
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.round_deleted,
+        org_id=org.id,
+        actor_id=user.id,
+        entity_type="funding_round",
+        entity_id=row.id,
+        link_url=f"/startup/rounds/{row.id}",
+        summary=f"{user.display_name or 'A member'} deleted round “{row.name}”.",
+    )
+    row.deleted_at = datetime.now(UTC)
+    await db.commit()
+
+
+async def summary(db: AsyncSession, user: User, org_id: uuid.UUID) -> FundingRoundSummary:
+    """Org-level roll-up for the rounds header (one aggregate query)."""
+    org = await organization_service.startup_org_or_404(db, org_id)
+    await organization_service.require_membership(db, org.id, user)
+
+    where = [FundingRound.org_id == org.id, FundingRound.deleted_at.is_(None)]
+
+    total_target, total_committed = (
+        await db.execute(
+            select(
+                func.coalesce(func.sum(FundingRound.target_amount), 0),
+                func.coalesce(func.sum(FundingRound.committed_amount), 0),
+            ).where(*where)
+        )
+    ).one()
+
+    open_rounds, currency = (
+        await db.execute(
+            select(
+                func.count(FundingRound.id).filter(
+                    FundingRound.status.in_(
+                        [RoundStatus.open.value, RoundStatus.paused.value]
+                    )
+                ),
+                func.coalesce(func.min(FundingRound.currency), "INR"),
+            ).select_from(FundingRound).where(*where)
+        )
+    ).one()
+
+    status_rows = (
+        await db.execute(
+            select(FundingRound.status, func.count())
+            .where(*where)
+            .group_by(FundingRound.status)
+        )
+    ).all()
+
+    # Coerce explicitly: SQLite has no DECIMAL, so an aggregate may
+    # come back as float/int; Decimal(str(...)) keeps it a real decimal
+    # either way (the 8h pattern).
+    return FundingRoundSummary(
+        total_target=Decimal(str(total_target)),
+        total_committed=Decimal(str(total_committed)),
+        currency=currency,
+        open_rounds=open_rounds,
+        by_status={status_value: count for status_value, count in status_rows},
+    )
+
+
+__all__ = [
+    "WRITE_ROLES",
+    "create",
+    "delete_round",
+    "get_round",
+    "list_rounds",
+    "summary",
+    "transition_status",
+    "update_round",
+]
diff --git a/backend/app/tests/test_funding_rounds.py b/backend/app/tests/test_funding_rounds.py
