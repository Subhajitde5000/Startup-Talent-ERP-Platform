+            )
+            .order_by(InvestorEngagementRequest.created_at.desc())
+            .limit(3)
+        )
+    ).all()
+    needs_reply = [
+        NeedsReplyItem(
+            id=req.id,
+            startup_org_id=req.startup_org_id,
