+++ b/backend/app/routers/investor_deal.py
@@ -0,0 +1,207 @@
+"""Investor pipeline router (Step 9e).
+
+Investor side under ``/investors/deals`` (the caller's own firm,
+resolved from membership); startup side under
+``/organizations/{org_id}/investor-deals`` (the caller's startup). The
+``/summary`` route is declared before ``/{deal_id}`` so it is not
+matched as a deal id.
+"""
+
+import uuid
+from typing import Annotated
+
+from fastapi import APIRouter, Depends, Query, Response
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.core.dependencies import get_current_user
+from app.db.session import get_db
+from app.models.investor_deal import PipelineStage
+from app.models.user import User
+from app.schemas.investor_deal import (
+    InvestorDealCreate,
+    InvestorDealHistoryPage,
+    InvestorDealPage,
+    InvestorDealRead,
+    InvestorDealSummary,
+    InvestorDealUpdate,
+    StartupInvestorDealPage,
+    StartupInvestorDealRead,
+    StartupInvestorDealStageUpdate,
+)
+from app.services import investor_deal_service
+
+router = APIRouter(tags=["investor pipeline"])
+
+
+# --- investor side ---------------------------------------------------------
+
+
+@router.get(
+    "/investors/deals",
+    response_model=InvestorDealPage,
+    summary="List the investor's deals",
+)
+async def list_deals(
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+    stage: PipelineStage | None = None,
+    q: Annotated[str | None, Query(max_length=100)] = None,
+    limit: Annotated[int, Query(ge=1, le=50)] = 20,
+    offset: Annotated[int, Query(ge=0)] = 0,
+) -> InvestorDealPage:
+    items, total = await investor_deal_service.list_deals(
+        db, user, stage=stage, q=q, limit=limit, offset=offset
+    )
+    return InvestorDealPage(items=items, total=total, limit=limit, offset=offset)
+
+
+@router.post(
+    "/investors/deals",
+    response_model=InvestorDealRead,
+    status_code=201,
+    summary="Create a deal",
+)
+async def create_deal(
+    payload: InvestorDealCreate,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> InvestorDealRead:
+    return await investor_deal_service.create_deal(db, user, payload)
+
+
+@router.get(
+    "/investors/deals/summary",
+    response_model=InvestorDealSummary,
+    summary="Deal counts per stage",
+)
+async def summary(
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> InvestorDealSummary:
+    return await investor_deal_service.summary(db, user)
+
+
+@router.get(
+    "/investors/deals/{deal_id}",
+    response_model=InvestorDealRead,
+    summary="One deal",
+)
+async def get_deal(
+    deal_id: uuid.UUID,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> InvestorDealRead:
+    return await investor_deal_service.get_deal(db, user, deal_id)
+
+
+@router.patch(
+    "/investors/deals/{deal_id}",
+    response_model=InvestorDealRead,
+    summary="Update a deal",
+)
+async def update_deal(
+    deal_id: uuid.UUID,
+    payload: InvestorDealUpdate,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> InvestorDealRead:
+    return await investor_deal_service.update_deal(db, user, deal_id, payload)
+
+
+@router.delete(
+    "/investors/deals/{deal_id}",
+    status_code=204,
+    summary="Delete a deal",
+)
+async def delete_deal(
+    deal_id: uuid.UUID,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> Response:
+    await investor_deal_service.delete_deal(db, user, deal_id)
+    return Response(status_code=204)
+
+
+@router.get(
+    "/investors/deals/{deal_id}/history",
+    response_model=InvestorDealHistoryPage,
+    summary="Stage history of a deal",
+)
+async def deal_history(
+    deal_id: uuid.UUID,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+    limit: Annotated[int, Query(ge=1, le=50)] = 20,
+    offset: Annotated[int, Query(ge=0)] = 0,
+) -> InvestorDealHistoryPage:
+    return await investor_deal_service.deal_history(
+        db, user, deal_id, limit=limit, offset=offset
+    )
+
+
+# --- startup side ---------------------------------------------------------
+
+
+@router.get(
+    "/organizations/{org_id}/investor-deals",
+    response_model=StartupInvestorDealPage,
+    summary="List investors dealing with this startup",
+)
+async def list_startup_deals(
+    org_id: uuid.UUID,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+    limit: Annotated[int, Query(ge=1, le=50)] = 20,
+    offset: Annotated[int, Query(ge=0)] = 0,
+) -> StartupInvestorDealPage:
+    items, total = await investor_deal_service.list_startup_deals(
+        db, user, org_id, limit=limit, offset=offset
+    )
+    return StartupInvestorDealPage(items=items, total=total, limit=limit, offset=offset)
+
+
+@router.get(
+    "/organizations/{org_id}/investor-deals/{investor_org_id}",
+    response_model=StartupInvestorDealRead,
+    summary="One investor's deal with this startup",
+)
+async def get_startup_deal(
+    org_id: uuid.UUID,
+    investor_org_id: uuid.UUID,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> StartupInvestorDealRead:
+    return await investor_deal_service.get_startup_deal(
+        db, user, org_id, investor_org_id
+    )
+
+
+@router.patch(
+    "/organizations/{org_id}/investor-deals/{investor_org_id}",
+    response_model=StartupInvestorDealRead,
+    summary="Update the shared deal stage (startup side)",
+)
+async def update_startup_deal_stage(
+    org_id: uuid.UUID,
+    investor_org_id: uuid.UUID,
+    payload: StartupInvestorDealStageUpdate,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+) -> StartupInvestorDealRead:
+    return await investor_deal_service.update_startup_deal_stage(
+        db, user, org_id, investor_org_id, payload.stage
+    )
+
+
+__all__ = [
+    "create_deal",
+    "deal_history",
+    "delete_deal",
+    "get_deal",
+    "get_startup_deal",
+    "list_deals",
+    "list_startup_deals",
+    "summary",
+    "update_deal",
+    "update_startup_deal_stage",
+]
diff --git a/backend/app/routers/investor_directory.py b/backend/app/routers/investor_directory.py
new file mode 100644
index 0000000..d5b684f
--- /dev/null
+++ b/backend/app/routers/investor_directory.py
@@ -0,0 +1,122 @@
+"""Investor directory router (Step 9b).
+
+Startup-side, read-only endpoints under
+``/organizations/{org_id}/investors``. The org in the path is the
+caller's STARTUP (any role, including viewer); every function in the
+service re-checks membership.
+"""
+
+import uuid
+from decimal import Decimal
+from typing import Annotated
+
+from fastapi import APIRouter, Depends, Query
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.core.dependencies import get_current_user
+from app.core.exceptions import validation_error
+from app.db.session import get_db
+from app.models.investor_search import InvestorType
+from app.models.startup import StartupStage
+from app.models.user import User
+from app.schemas.investor_directory import (
+    InvestorDirectoryDetail,
+    InvestorDirectoryFacets,
+    InvestorDirectoryPage,
+    InvestorDirectorySummary,
+)
+from app.services import investor_directory_service
+
+router = APIRouter(tags=["investor directory"])
+
+
+@router.get(
+    "/organizations/{org_id}/investors",
+    response_model=InvestorDirectoryPage,
+    summary="Search the investor directory",
+)
+async def list_investors(
+    org_id: uuid.UUID,
+    db: Annotated[AsyncSession, Depends(get_db)],
+    user: Annotated[User, Depends(get_current_user)],
+    q: Annotated[str | None, Query(max_length=100)] = None,
+    investor_type: InvestorType | None = None,
+    sector: Annotated[str | None, Query(max_length=120)] = None,
+    stage_focus: StartupStage | None = None,
+    ticket_min: Annotated[Decimal | None, Query(ge=0, decimal_places=2)] = None,
+    ticket_max: Annotated[Decimal | None, Query(ge=0, decimal_places=2)] = None,
+    location: Annotated[str | None, Query(max_length=120)] = None,
+    verified_only: bool = False,
+    sort: str = "recent",
+    limit: Annotated[int, Query(ge=1, le=50)] = 20,
+    offset: Annotated[int, Query(ge=0)] = 0,
+) -> InvestorDirectoryPage:
+    if ticket_min is not None and ticket_max is not None and ticket_min > ticket_max:
+        raise validation_error("ticket_min must not exceed ticket_max.")
+    items, total = await investor_directory_service.list_investors(
+        db,
+        user,
+        org_id,
+        q=q,
+        investor_type=investor_type,
+        sector=sector,
+        stage_focus=stage_focus,
+        ticket_min=ticket_min,
+        ticket_max=ticket_max,
+        location=location,
+        verified_only=verified_only,
+        sort=sort,
+        limit=limit,
+        offset=offset,
+    )
+    return InvestorDirectoryPage(items=items, total=total, limit=limit, offset=offset)
+
+
+@router.get(
+    "/organizations/{org_id}/investors/summary",
+    response_model=InvestorDirectorySummary,
+    summary="Directory header counts",
+)
+async def summary(
+    org_id: uuid.UUID,
+    user: Annotated[User, Depends(get_current_user)],
+    db: Annotated[AsyncSession, Depends(get_db)],
+) -> InvestorDirectorySummary:
+    return await investor_directory_service.summary(db, user, org_id)
+
+
+@router.get(
+    "/organizations/{org_id}/investors/filters",
+    response_model=InvestorDirectoryFacets,
+    summary="Directory filter facets",
+)
+async def filters(
+    org_id: uuid.UUID,
+    user: Annotated[User, Depends(get_current_user)],
+    db: Annotated[AsyncSession, Depends(get_db)],
+) -> InvestorDirectoryFacets:
+    return await investor_directory_service.facets(db, user, org_id)
+
+
+@router.get(
+    "/organizations/{org_id}/investors/{investor_org_id}",
+    response_model=InvestorDirectoryDetail,
+    summary="One investor firm",
+)
+async def get_investor(
+    org_id: uuid.UUID,
+    investor_org_id: uuid.UUID,
+    user: Annotated[User, Depends(get_current_user)],
+    db: Annotated[AsyncSession, Depends(get_db)],
+) -> InvestorDirectoryDetail:
+    return await investor_directory_service.get_investor(
+        db, user, org_id, investor_org_id
+    )
+
+
+__all__ = [
+    "filters",
+    "get_investor",
+    "list_investors",
+    "summary",
+]
