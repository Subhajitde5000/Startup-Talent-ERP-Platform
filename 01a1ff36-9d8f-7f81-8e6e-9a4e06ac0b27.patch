+    InvestorOfferUpdate,
+    OfferHistoryPage,
+    StartupOfferPage,
+    StartupOfferRead,
+)
+from app.services import investor_offer_service
+
+router = APIRouter(tags=["investor offers"])
+
+
+# --- investor side ---------------------------------------------------------
+
+
+@router.get(
