@@ -0,0 +1,345 @@
+"""Bounded validation, fail-closed scanner hook, thumbnails and retryable jobs.
+
+A database lease claims each file without holding a transaction during I/O.
+Each attempt writes different final keys, and only the lease holder can publish.
+A deleted row can never be republished. Maintenance removes abandoned attempts.
+"""
+
+import asyncio
+import hashlib
+import io
+import logging
+import uuid
+import warnings
+import zipfile
+from datetime import timedelta
+from pathlib import PurePosixPath
+from typing import Protocol
+
+from PIL import Image, ImageOps, UnidentifiedImageError
+from sqlalchemy import or_, select, update
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
+
+from app.core.config import get_settings
+from app.models.activity import ActivityEventType
+from app.models.file import File
+from app.schemas.file import max_bytes
+from app.services.file_service import audit, aware, file_prefix, now
+from app.services.storage_service import Storage, StorageInvalid, StorageMissing
+
+logger = logging.getLogger("forma")
+
+
+class Scanner(Protocol):
+    async def scan(self, data: bytes, mime: str) -> str: ...
+
+
+class ConfiguredScanner:
+    async def scan(self, data: bytes, mime: str) -> str:
+        settings = get_settings()
+        if settings.FILE_SCANNER == "dev_clean" and not settings.is_prod:
+            return "clean"
+        # Intentional stub: an unavailable production scanner NEVER approves bytes.
+        return "failed"
+
+
+def get_scanner() -> Scanner:
+    return ConfiguredScanner()
+
+
+def validate_bytes(data: bytes, mime: str, name: str) -> bytes | None:
+    """Structural checks supplement, but do not replace, malware scanning."""
+    ext = PurePosixPath(name).suffix.lower()
+    if mime.startswith("image/"):
+        try:
+            with warnings.catch_warnings():
+                warnings.simplefilter("error", Image.DecompressionBombWarning)
+                with Image.open(io.BytesIO(data)) as image:
+                    expected = {"image/png": "PNG", "image/jpeg": "JPEG", "image/webp": "WEBP"}[
+                        mime
+                    ]
+                    if (
+                        image.format != expected
+                        or image.width * image.height > 20_000_000
+                        or getattr(image, "n_frames", 1) != 1
+                    ):
+                        raise ValueError("Unsupported image.")
+                    image.verify()
+                with Image.open(io.BytesIO(data)) as image:
+                    image.load()
+                    thumb = ImageOps.exif_transpose(image).convert("RGB")
+                    thumb.thumbnail((256, 256))
+                    output = io.BytesIO()
+                    thumb.save(output, format="WEBP", quality=85)
+                    return output.getvalue()
+        except (
+            UnidentifiedImageError,
+            OSError,
+            Image.DecompressionBombError,
+            Image.DecompressionBombWarning,
+            KeyError,
+        ) as exc:
+            raise ValueError("Invalid image.") from exc
+    elif ext == ".pdf":
+        if not data.startswith(b"%PDF-") or b"%%EOF" not in data[-2048:]:
+            raise ValueError("Invalid PDF signature.")
+    elif ext in {".docx", ".pptx", ".xlsx"}:
+        required = {
+            ".docx": "word/document.xml",
+            ".pptx": "ppt/presentation.xml",
+            ".xlsx": "xl/workbook.xml",
+        }[ext]
+        try:
+            with zipfile.ZipFile(io.BytesIO(data)) as archive:
+                members = archive.infolist()
+                names = {item.filename for item in members}
+                if (
+                    len(members) > 2000
+                    or len(names) != len(members)
+                    or sum(item.file_size for item in members) > 50 * 1024 * 1024
+                ):
+                    raise ValueError("Office container exceeds limits.")
+                if required not in names or "[Content_Types].xml" not in names:
+                    raise ValueError("Wrong Office container.")
+                for item in members:
+                    path = PurePosixPath(item.filename)
+                    if (
+                        item.flag_bits & 1
+                        or path.is_absolute()
+                        or ".." in path.parts
+                        or "\\" in item.filename
+                        or "vbaproject" in item.filename.lower()
+                        or item.filename.lower().endswith((".exe", ".dll", ".bin"))
+                    ):
+                        raise ValueError("Unsafe Office container.")
+                    # Bound expansion and force CRC/decompression verification.
+                    with archive.open(item) as stream:
+                        if len(stream.read(50 * 1024 * 1024 + 1)) != item.file_size:
+                            raise ValueError("Invalid Office member.")
+        except (zipfile.BadZipFile, RuntimeError, NotImplementedError, OSError) as exc:
+            raise ValueError("Invalid Office document.") from exc
+    else:
+        text = data.decode("utf-8-sig")
+        if any(ord(char) < 32 and char not in "\r\n\t" for char in text):
+            raise ValueError("Invalid text document.")
+    return None
+
+
+async def process_file(
+    file_id: uuid.UUID,
+    sessions: async_sessionmaker[AsyncSession],
+    storage: Storage,
+    scanner: Scanner,
+) -> None:
+    token = uuid.uuid4()
+    async with sessions() as db:
+        claim = await db.execute(
+            update(File)
+            .where(
+                File.id == file_id,
+                File.deleted_at.is_(None),
+                File.upload_status == "uploaded",
+                or_(File.processing_expires_at.is_(None), File.processing_expires_at < now()),
+            )
+            .values(processing_token=token, processing_expires_at=now() + timedelta(minutes=10))
+            .returning(File.id)
+        )
+        await db.commit()
+        if claim.scalar_one_or_none() is None:
+            return
+        row = (await db.execute(select(File).where(File.id == file_id))).scalar_one()
+        # expire_on_commit may be enabled on a supplied factory; retain scalar snapshot.
+        staging, mime, size, name, kind, prefix = (
+            row.upload_storage_key,
+            row.mime_type,
+            row.byte_size,
+            row.file_name,
+            row.kind,
+            file_prefix(row),
+        )
+    scan, status, checksum, thumbnail = "failed", "uploaded", None, None
+    final = f"{prefix}{token.hex}"
+    thumb_key = f"{prefix}{token.hex}.webp"
+    published = False
+    wrote_final = False
+    try:
+        if not staging:
+            raise StorageInvalid("Missing staging object.")
+        data, stored_mime = await storage.read(staging, max_bytes(kind))
+        if len(data) != size or stored_mime != mime:
+            raise StorageInvalid("Uploaded metadata does not match the reservation.")
+        thumbnail = await asyncio.to_thread(validate_bytes, data, mime, name)
+        checksum = hashlib.sha256(data).hexdigest()
+        scan = await asyncio.wait_for(scanner.scan(data, mime), timeout=120)
+        if scan not in {"clean", "infected", "failed"}:
+            scan = "failed"
+        if scan == "clean":
+            await storage.put(final, data, mime)
+            wrote_final = True
+            if thumbnail:
+                await storage.put(thumb_key, thumbnail, "image/webp")
+            status = "ready"
+        elif scan == "infected":
+            status = "rejected"
+    except (ValueError, StorageInvalid):
+        scan, status = "failed", "rejected"
+    except StorageMissing:
+        # Direct upload can still be completing: maintenance retries until expiry grace.
+        scan, status = "pending", "uploaded"
+    except Exception:
+        # Persist a retryable failure, without leaking provider details or file content.
+        scan, status = "failed", "uploaded"
+        logger.warning("File processing failed; retry scheduled", extra={"file_id": str(file_id)})
+    try:
+        async with sessions() as db:
+            values: dict = dict(
+                scan_status=scan,
+                upload_status=status,
+                scanned_at=now() if scan != "pending" else None,
+                checksum_sha256=checksum,
+                processing_token=None,
+                processing_expires_at=None,
+            )
+            if status == "ready":
+                values.update(
+                    storage_key=final, thumbnail_storage_key=thumb_key if thumbnail else None
+                )
+            result = await db.execute(
+                update(File)
+                .where(
+                    File.id == file_id,
+                    File.processing_token == token,
+                    File.deleted_at.is_(None),
+                    File.upload_status == "uploaded",
+                    File.processing_expires_at > now(),
+                )
+                .values(**values)
+                .returning(File.id)
+            )
+            changed = result.scalar_one_or_none() is not None
+            if changed:
+                row = (await db.execute(select(File).where(File.id == file_id))).scalar_one()
+                audit(db, row, ActivityEventType.file_processed)
+            await db.commit()
+            published = bool(changed and status == "ready")
+    finally:
+        if wrote_final and not published:
+            # Best effort here; maintenance also reaps crash leftovers by prefix.
+            try:
+                await storage.delete(final)
+                await storage.delete(thumb_key)
+            except Exception:
+                logger.warning("File attempt cleanup deferred", extra={"file_id": str(file_id)})
+
+
+async def process_in_background(file_id: uuid.UUID, scanner: Scanner, storage: Storage) -> None:
+    from app.db.session import async_session_factory
+
+    try:
+        await process_file(file_id, async_session_factory, storage, scanner)
+    except Exception:
+        logger.warning(
+            "File job interrupted; maintenance will retry", extra={"file_id": str(file_id)}
+        )
+
+
+async def maintain_files(
+    sessions: async_sessionmaker[AsyncSession],
+    storage: Storage,
+    scanner: Scanner,
+    batch_size: int = 100,
+) -> dict[str, int]:
+    """Keyset batches; per-file CAS leases protect overlap with API/other runs."""
+    if not 1 <= batch_size <= 1000:
+        raise ValueError("batch_size must be between 1 and 1000")
+    cutoff = now() - timedelta(hours=get_settings().FILE_RETENTION_HOURS)
+    stats = {"visited": 0, "retried": 0, "purged": 0, "failed": 0}
+    last_id = None
+    while True:
+        async with sessions() as db:
+            query = (
+                select(File.id)
+                .where(
+                    File.purged_at.is_(None),
+                    or_(
+                        File.upload_status.in_(["pending", "uploaded", "rejected", "expired"]),
+                        File.deleted_at.is_not(None),
+                        File.upload_storage_key.is_not(None),
+                        (File.owner_org_id.is_(None))
+                        & File.storage_key.startswith("organizations/"),
+                        (File.owner_org_id.is_(None)) & File.uploaded_by.is_(None),
+                    ),
+                )
+                .order_by(File.id)
+                .limit(batch_size)
+            )
+            if last_id:
+                query = query.where(File.id > last_id)
+            ids = list((await db.execute(query)).scalars())
+        if not ids:
+            break
+        for file_id in ids:
+            stats["visited"] += 1
+            try:
+                async with sessions() as db:
+                    row = await db.get(File, file_id)
+                    if row is None:
+                        continue
+                    # Do not purge while a current worker can still write objects.
+                    if row.processing_expires_at and aware(row.processing_expires_at) > now():
+                        continue
+                    orphan = (
+                        row.owner_org_id is None and row.storage_key.startswith("organizations/")
+                    ) or (row.owner_org_id is None and row.uploaded_by is None)
+                    if orphan and row.deleted_at is None:
+                        row.deleted_at = now()
+                        audit(db, row, ActivityEventType.file_deleted)
+                        await db.commit()
+                        await db.refresh(row)
+                    deadline = aware(row.upload_expires_at)
+                    if (
+                        row.deleted_at is None
+                        and row.upload_status in {"pending", "uploaded"}
+                        and deadline < cutoff
+                    ):
+                        row.upload_status = "expired"
+                        audit(db, row, ActivityEventType.file_expired)
+                        await db.commit()
+                        await db.refresh(row)
+                    prefix, staging = file_prefix(row), row.upload_storage_key
+                    purge = bool(
+                        (row.deleted_at and aware(row.deleted_at) < cutoff)
+                        or (row.upload_status in {"expired", "rejected"} and deadline < cutoff)
+                    )
+                    retry = row.upload_status == "uploaded" and row.deleted_at is None
+                    ready = row.upload_status == "ready" and row.deleted_at is None
+                    keep = {row.storage_key, row.thumbnail_storage_key or ""} if ready else set()
+                # No database transaction remains open over network I/O.
+                if retry:
+                    await process_file(file_id, sessions, storage, scanner)
+                    stats["retried"] += 1
+                if purge or (ready and deadline < cutoff):
+                    await storage.cleanup_prefix(prefix, keep, now())
+                    if staging and (purge or deadline < cutoff):
+                        await storage.delete(staging)
+                    async with sessions() as db:
+                        row = await db.get(File, file_id)
+                        if row is not None:
+                            if staging and (purge or deadline < cutoff):
+                                row.upload_storage_key = None
+                            if purge:
+                                purged = await db.execute(
+                                    update(File)
+                                    .where(File.id == file_id, File.purged_at.is_(None))
+                                    .values(purged_at=now())
+                                    .returning(File.id)
+                                )
+                                if purged.scalar_one_or_none() is not None:
+                                    audit(db, row, ActivityEventType.file_purged)
+                                    stats["purged"] += 1
+                            await db.commit()
+            except Exception:
+                stats["failed"] += 1
+                logger.warning("File maintenance deferred", extra={"file_id": str(file_id)})
+        last_id = ids[-1]
+    return stats
diff --git a/backend/app/services/file_service.py b/backend/app/services/file_service.py
new file mode 100644
index 0000000..caf50a6
--- /dev/null
+++ b/backend/app/services/file_service.py
@@ -0,0 +1,307 @@
+"""File ownership, reservations, confirmation and short-lived download grants."""
+
+import uuid
+from datetime import UTC, datetime, timedelta
+
+from sqlalchemy import func, or_, select, update
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.core.config import get_settings
+from app.core.exceptions import (
+    AuthError,
+    conflict,
+    forbidden,
+    not_found,
+    rate_limited,
+    validation_error,
+)
+from app.models.activity import ActivityEventType
+from app.models.file import File
+from app.models.organization import OrganizationMember, OrgRole
+from app.models.user import User
+from app.schemas.file import FilePage, FileRead, FileUploadCreate, FileUploadRead
+from app.services import activity_service, organization_service
+from app.services.rate_limiter import rate_limiter
+from app.services.storage_service import Storage
+
+WRITE_ROLES = {OrgRole.owner, OrgRole.admin, OrgRole.member}
+
+
+def now() -> datetime:
+    return datetime.now(UTC)
+
+
+def aware(value: datetime) -> datetime:
+    return value.replace(tzinfo=UTC) if value.tzinfo is None else value
+
+
+def file_prefix(row: File) -> str:
+    return row.storage_key.rsplit("/", 1)[0] + "/"
+
+
+def audit(
+    db: AsyncSession, row: File, event: ActivityEventType, actor: uuid.UUID | None = None
+) -> None:
+    activity_service.record(
+        db,
+        event_type=event,
+        summary=f"File {event.value.removeprefix('file_').replace('_', ' ')}.",
+        org_id=row.owner_org_id,
+        actor_id=actor,
+        entity_type="file",
+        entity_id=row.id,
+    )
+
+
+async def enforce_limit(key: str, limit: int, seconds: int) -> None:
+    if not await rate_limiter.check(key, limit, seconds):
+        raise rate_limited("Too many file operations. Please try again later.")
+
+
+async def org_access(
+    db: AsyncSession, user: User, org_id: uuid.UUID, *, write: bool = False
+) -> OrganizationMember:
+    org = await organization_service.org_or_404(db, org_id)
+    if org.status != "active":
+        raise not_found("Organization not found.")
+    # Reuse the membership helper; conceal non-membership, not role denials.
+    try:
+        membership = await organization_service.require_membership(db, org.id, user)
+    except AuthError as exc:
+        if exc.status_code == 403:
+            raise not_found("Organization not found.") from None
+        raise
+    if write and membership.role not in WRITE_ROLES:
+        raise forbidden()
+    return membership
+
+
+async def file_access(
+    db: AsyncSession, user: User, file_id: uuid.UUID, *, action: str = "read"
+) -> File:
+    query = select(File).where(File.id == file_id, File.deleted_at.is_(None))
+    if action == "delete":
+        query = query.with_for_update()
+    row = (await db.execute(query)).scalar_one_or_none()
+    if row is None:
+        raise not_found("File not found.")
+    if row.owner_org_id is not None:
+        membership = await org_access(db, user, row.owner_org_id, write=action != "read")
+        if (
+            action in {"confirm", "delete"}
+            and membership.role == OrgRole.member
+            and row.uploaded_by != user.id
+        ):
+            raise forbidden()
+    elif row.uploaded_by != user.id or not row.storage_key.startswith(f"personal/{user.id}/"):
+        raise not_found("File not found.")
+    return row
+
+
+async def request_upload(
+    db: AsyncSession,
+    user: User,
+    payload: FileUploadCreate,
+    storage: Storage,
+    org_id: uuid.UUID | None = None,
+) -> FileUploadRead:
+    settings = get_settings()
+    # Lock the actor row to serialize reservation quotas across API instances.
+    await db.execute(select(User.id).where(User.id == user.id).with_for_update())
+    if org_id is not None:
+        await org_access(db, user, org_id, write=True)
+    await enforce_limit(f"file_upload:user:{user.id}", settings.FILE_UPLOAD_USER_LIMIT, 3600)
+    if org_id is not None:
+        await enforce_limit(f"file_upload:org:{org_id}", settings.FILE_UPLOAD_ORG_LIMIT, 3600)
+    count = (
+        await db.execute(
+            select(func.count())
+            .select_from(File)
+            .where(
+                File.uploaded_by == user.id,
+                File.deleted_at.is_(None),
+                or_(
+                    File.upload_status == "uploaded",
+                    (File.upload_status == "pending") & (File.upload_expires_at > now()),
+                ),
+            )
+        )
+    ).scalar_one()
+    if count >= settings.FILE_PENDING_LIMIT:
+        raise conflict("Too many unfinished uploads.", "FILE_PENDING_LIMIT")
+    file_id = uuid.uuid4()
+    prefix = f"organizations/{org_id}/{file_id}" if org_id else f"personal/{user.id}/{file_id}"
+    staging = f"staging/{prefix}/upload"
+    url = await storage.sign_upload(staging, payload.mime_type, settings.FILE_UPLOAD_TTL_SECONDS)
+    row = File(
+        id=file_id,
+        owner_org_id=org_id,
+        uploaded_by=user.id,
+        kind=payload.kind.value,
+        file_name=payload.file_name,
+        mime_type=payload.mime_type,
+        byte_size=payload.byte_size,
+        storage_key=f"{prefix}/reserved",
+        upload_storage_key=staging,
+        upload_expires_at=now() + timedelta(seconds=settings.FILE_UPLOAD_TTL_SECONDS),
+    )
+    db.add(row)
+    audit(db, row, ActivityEventType.file_upload_requested, user.id)
+    await db.commit()
+    await db.refresh(row)
+    return FileUploadRead(
+        file=FileRead.model_validate(row),
+        upload_url=url,
+        headers={"Content-Type": row.mime_type},
+        expires_in=settings.FILE_UPLOAD_TTL_SECONDS,
+    )
+
+
+async def list_files(
+    db: AsyncSession,
+    user: User,
+    org_id: uuid.UUID | None,
+    *,
+    limit: int,
+    offset: int,
+    kind: str | None,
+    sort: str,
+    order: str,
+) -> FilePage:
+    if org_id:
+        await org_access(db, user, org_id)
+        filters = [File.owner_org_id == org_id]
+    else:
+        filters = [
+            File.owner_org_id.is_(None),
+            File.uploaded_by == user.id,
+            File.storage_key.startswith(f"personal/{user.id}/"),
+        ]
+    filters.append(File.deleted_at.is_(None))
+    if kind:
+        filters.append(File.kind == kind)
+    total = (await db.execute(select(func.count()).select_from(File).where(*filters))).scalar_one()
+    column = {"created_at": File.created_at, "file_name": File.file_name}[sort]
+    rows = (
+        (
+            await db.execute(
+                select(File)
+                .where(*filters)
+                .order_by(column.desc() if order == "desc" else column.asc(), File.id)
+                .limit(limit)
+                .offset(offset)
+            )
+        )
+        .scalars()
+        .all()
+    )
+    return FilePage(
+        items=[FileRead.model_validate(row) for row in rows],
+        total=total,
+        limit=limit,
+        offset=offset,
+    )
+
+
+async def confirm(db: AsyncSession, user: User, file_id: uuid.UUID) -> FileRead:
+    row = await file_access(db, user, file_id, action="confirm")
+    await enforce_limit(f"file_action:{user.id}", get_settings().FILE_ACTION_LIMIT, 300)
+    if row.upload_status in {"expired", "rejected"}:
+        raise conflict("This upload can no longer be confirmed.", "FILE_UPLOAD_CLOSED")
+    if row.upload_status == "pending":
+        if aware(row.upload_expires_at) <= now():
+            raise conflict("The upload reservation has expired.", "FILE_UPLOAD_EXPIRED")
+        result = await db.execute(
+            update(File)
+            .where(File.id == row.id, File.upload_status == "pending", File.deleted_at.is_(None))
+            .values(upload_status="uploaded", confirmed_at=now())
+            .returning(File.id)
+        )
+        if result.scalar_one_or_none() is not None:
+            audit(db, row, ActivityEventType.file_confirmed, user.id)
+        await db.commit()
+        await db.refresh(row)
+    return FileRead.model_validate(row)
+
+
+async def download(
+    db: AsyncSession, user: User, file_id: uuid.UUID, variant: str, storage: Storage
+) -> tuple[str, int]:
+    row = await file_access(db, user, file_id)
+    settings = get_settings()
+    await enforce_limit(f"file_download:{user.id}", settings.FILE_DOWNLOAD_LIMIT, 300)
+    if row.upload_status != "ready" or row.scan_status != "clean":
+        raise conflict("This file is not available for download.", "FILE_NOT_READY")
+    key, mime, name = row.storage_key, row.mime_type, row.file_name
+    if variant == "thumbnail":
+        if not row.thumbnail_storage_key:
+            raise not_found("Thumbnail not found.")
+        key, mime, name = row.thumbnail_storage_key, "image/webp", "thumbnail.webp"
+    return await storage.sign_download(
+        key, name, mime, settings.FILE_DOWNLOAD_TTL_SECONDS, image=mime.startswith("image/")
+    ), settings.FILE_DOWNLOAD_TTL_SECONDS
+
+
+async def delete_file(db: AsyncSession, user: User, file_id: uuid.UUID) -> None:
+    row = await file_access(db, user, file_id, action="delete")
+    await enforce_limit(f"file_action:{user.id}", get_settings().FILE_ACTION_LIMIT, 300)
+    from app.models.organization import Organization
+    from app.models.startup import StartupProfile
+
+    # Soft deletion must detach selected files in the SAME transaction.
+    await db.execute(
+        update(Organization).where(Organization.logo_file_id == row.id).values(logo_file_id=None)
+    )
+    await db.execute(
+        update(StartupProfile)
+        .where(StartupProfile.pitch_deck_file_id == row.id)
+        .values(pitch_deck_file_id=None)
+    )
+    row.deleted_at = now()
+    audit(db, row, ActivityEventType.file_deleted, user.id)
+    await db.commit()
+
+
+async def require_org_attachment(
+    db: AsyncSession, user: User, org_id: uuid.UUID, file_id: uuid.UUID, kind: str, field: str
+) -> File:
+    """Parent write permission is checked by its service; validate same-org file.
+
+    Lock against concurrent deletion. Foreign, missing, deleted, unscanned and
+    wrong-kind IDs share one field error rather than revealing file existence.
+    """
+    await org_access(db, user, org_id, write=True)
+    row = (
+        await db.execute(
+            select(File)
+            .where(
+                File.id == file_id,
+                File.owner_org_id == org_id,
+                File.kind == kind,
+                File.deleted_at.is_(None),
+                File.purged_at.is_(None),
+                File.upload_status == "ready",
+                File.scan_status == "clean",
+            )
+            .with_for_update()
+        )
+    ).scalar_one_or_none()
+    if row is None:
+        message = f"Select a ready, clean {kind} file belonging to this organization."
+        raise validation_error(
+            message, details=[{"loc": ["body", field], "msg": message, "type": "value_error"}]
+        )
+    return row
+
+
+def record_attachment_change(db: AsyncSession, user: User, org_id: uuid.UUID, field: str) -> None:
+    activity_service.record(
+        db,
+        event_type=ActivityEventType.file_attachment_changed,
+        summary="Organization file selection changed.",
+        org_id=org_id,
+        actor_id=user.id,
+        entity_type="organization",
+        entity_id=org_id,
+        data={"field": field},
+    )
