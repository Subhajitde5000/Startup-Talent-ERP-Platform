# Forma backend — copy to .env and fill in. Never commit real secrets.

ENVIRONMENT=dev
# The development seed refuses all other values: use ENVIRONMENT=development to seed.
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./forma.db
# Production: postgresql+asyncpg://user:password@host:5432/dbname

JWT_SECRET=change-me-to-a-random-32-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
VERIFICATION_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=30
# DPDP data requests: due_at = received_at + N days (Step 3a).
DATA_REQUEST_DUE_DAYS=30
# Origin used to build absolute links in emails (password reset).
FRONTEND_BASE_URL=http://localhost:3000

EMAIL_PROVIDER=console
EMAIL_FROM=Forma <no-reply@forma.example>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
RESEND_API_KEY=

REDIS_URL=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Step 4: Cloudflare R2. Private bucket only; never expose credentials to Next.js.
# Account ID is the 32-character hexadecimal ID in your Cloudflare dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Default fails closed. dev_clean is an EXPLICIT non-production scanner stub.
FILE_SCANNER=unconfigured
FILE_UPLOAD_TTL_SECONDS=300
FILE_DOWNLOAD_TTL_SECONDS=60
FILE_UPLOAD_USER_LIMIT=20
FILE_UPLOAD_ORG_LIMIT=100
FILE_ACTION_LIMIT=60
FILE_DOWNLOAD_LIMIT=120
FILE_PENDING_LIMIT=10
FILE_RETENTION_HOURS=24
