# Database (Docker Compose maps container 5432 to host 5434)
DATABASE_URL=postgresql+asyncpg://forma:formadev@localhost:5434/startup_database

# Redis (Docker Compose maps container 6379 to host 6380)
REDIS_URL=redis://localhost:6380/0

# JWT Auth
# Secret must be at least 64 characters long
JWT_SECRET=replace-with-a-very-long-random-secret-key-at-least-64-characters-long-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@forma.local
RESEND_API_KEY=
RESEND_FROM=noreply@forma.dev

# CORS & Frontend
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# Security & Rate Limiting
LOGIN_MAX_ATTEMPTS_PER_IP=10
LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
RESEND_VERIFICATION_COOLDOWN_SECONDS=60
